// Gateway log cleanup with explicit root and cutoff inputs.
// The acceptance tests use fixtures inside the Lo repository.

flow NameCharacter(total: Int, index: Int, character: Scalar) -> Bool {
    return Match.new(index,
        0: Scalar.eq(character, Scalar.new("d")),
        1: Scalar.eq(character, Scalar.new("e")),
        2: Scalar.eq(character, Scalar.new("p")),
        3: Scalar.eq(character, Scalar.new("l")),
        4: Scalar.eq(character, Scalar.new("o")),
        5: Scalar.eq(character, Scalar.new("y")),
        6: Scalar.eq(character, Scalar.new("m")),
        7: Scalar.eq(character, Scalar.new("e")),
        8: Scalar.eq(character, Scalar.new("n")),
        9: Scalar.eq(character, Scalar.new("t")),
        10: Scalar.eq(character, Scalar.new("-")),
        Math.sub(total, 4): Scalar.eq(character, Scalar.new(".")),
        Math.sub(total, 3): Scalar.eq(character, Scalar.new("l")),
        Math.sub(total, 2): Scalar.eq(character, Scalar.new("o")),
        Math.sub(total, 1): Scalar.eq(character, Scalar.new("g")),
        _: Range.contains(
            Range.new(Scalar.new("0"), Scalar.new("9"), true, true),
            character
        )
    )
}

flow NameStep(total: Int, state: Record{index: Int, valid: Bool}, character: Scalar) -> Record{index: Int, valid: Bool} {
    valid = Match.new(state.valid,
        true: NameCharacter(total, state.index, character),
        _: false
    )
    return Record.new(index: Math.add(state.index, 1), valid: valid)
}

flow FullName(name: String, total: Int) -> Bool {
    initial = Record.new(index: 0, valid: true)
    result = List.fold(name, initial, total, NameStep)
    return result.valid
}

flow IsGatewayLogName(name: String) -> Bool {
    total = String.length(name)
    return Match.new(Math.gte(total, 16),
        true: FullName(name, total),
        _: false
    )
}

flow IsCandidate(cutoff_unix_ns: Int, entry: File.Entry) -> Bool {
    return Match.new(entry.kind,
        "regular": Match.new(IsGatewayLogName(entry.name),
            true: Math.lt(entry.modified_unix_ns, cutoff_unix_ns),
            _: false
        ),
        _: false
    )
}

flow EmptyEntries() -> List<File.Entry> { return List.new() }

flow ListingError(error: Error) -> Record{directory_status: String, entries: List<File.Entry>!} {
    return Record.new(directory_status: "absent", entries: Match.new(error.kind,
        "File.DirectoryAbsent": EmptyEntries(),
        _: error
    ))
}

flow Observe(root: File.Path) -> Record{directory_status: String, entries: List<File.Entry>!} onError ListingError {
    entries = File.list(root)
    return Record.new(directory_status: "present", entries: entries)
}

flow Select(root: File.Path, cutoff_unix_ns: Int) -> Record{directory_status: String, candidates: List<File.Entry>}! {
    observation = Observe(root)
    entries = observation.entries
    return Record.new(directory_status: observation.directory_status, candidates: entries |> List.filter(cutoff_unix_ns, IsCandidate))
}

flow SeenPath(target: File.Path, found: Bool, path: File.Path) -> Bool {
    return Match.new(found, true: true, _: File.Path.eq(path, target))
}

flow Closed(open_paths: List<File.Path>, entry: File.Entry) -> Bool {
    opened = List.fold(open_paths, false, entry.path, SeenPath)
    return Match.new(opened, true: false, _: true)
}

flow ProbeSelection(root: File.Path, candidates: List<File.Entry>) -> List<File.Entry>! {
    opened = File.open_paths(root)
    return candidates |> List.filter(opened, Closed)
}

flow Available(root: File.Path, candidates: List<File.Entry>) -> List<File.Entry>! {
    return Match.new(List.length(candidates),
        0: candidates,
        _: ProbeSelection(root, candidates)
    )
}

flow ObservedBytes(entry: File.Entry) -> Int { return entry.size_bytes }
flow CandidateName(entry: File.Entry) -> String { return entry.name }

flow Preview(root: File.Path, cutoff_unix_ns: Int) -> Record{directory_status: String, names: List<String>, selected_count: Int, observed_bytes: Int}! {
    observation = Select(root, cutoff_unix_ns)
    candidates = observation.candidates
    selected = Available(root, candidates)
    return Record.new(
        directory_status: observation.directory_status,
        names: selected |> List.map(CandidateName),
        selected_count: List.length(selected),
        observed_bytes: Math.sum(selected |> List.map(ObservedBytes))
    )
}

flow RemovalError(error: Error) -> Record{removed: Bool!} {
    return Record.new(removed: Match.new(error.kind,
        "File.EntryChanged": false,
        _: error
    ))
}

flow RemoveOne(entry: File.Entry) -> Record{removed: Bool!} onError RemovalError {
    removal = File.remove(List.new(entry))
    commit removal
    return Record.new(removed: true)
}

flow RemoveStep(state: Record{directory_status: String, removed_count: Int, observed_bytes: Int, skipped_count: Int}, entry: File.Entry) -> Record{directory_status: String, removed_count: Int, observed_bytes: Int, skipped_count: Int}! {
    outcome = RemoveOne(entry)
    removed = outcome.removed
    return Match.new(removed,
        true: Record.new(directory_status: state.directory_status, removed_count: Math.add(state.removed_count, 1), observed_bytes: Math.add(state.observed_bytes, entry.size_bytes), skipped_count: state.skipped_count),
        _: Record.new(directory_status: state.directory_status, removed_count: state.removed_count, observed_bytes: state.observed_bytes, skipped_count: Math.add(state.skipped_count, 1))
    )
}

flow Cleanup(root: File.Path, cutoff_unix_ns: Int) -> Record{directory_status: String, removed_count: Int, observed_bytes: Int, skipped_count: Int}! {
    observation = Select(root, cutoff_unix_ns)
    candidates = observation.candidates
    selected = Available(root, candidates)
    initial = Record.new(directory_status: observation.directory_status, removed_count: 0, observed_bytes: 0, skipped_count: Math.sub(List.length(candidates), List.length(selected)))
    return Flow.fold(selected, initial, RemoveStep)
}

// Tests supply the root and cutoff. Preview uses: return Preview(root, cutoff_unix_ns)
root = File.Path.new("gateway-logs")
cutoff_unix_ns = Int.new(2000000000000000000)
return Cleanup(root, cutoff_unix_ns)
