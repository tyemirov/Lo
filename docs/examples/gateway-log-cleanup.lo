// Gateway log cleanup with explicit root and cutoff inputs.
// The acceptance tests use fixtures inside the Lo repository.

flow NameCharacter(total: Int, index: Int, character: Scalar) -> Bool {
    flow NameCharacterChoiceTest1(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow NameCharacterChoiceResult1(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("d"))
    }

    flow NameCharacterChoiceTest2(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 1)
    }

    flow NameCharacterChoiceResult2(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("e"))
    }

    flow NameCharacterChoiceTest3(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 2)
    }

    flow NameCharacterChoiceResult3(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("p"))
    }

    flow NameCharacterChoiceTest4(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 3)
    }

    flow NameCharacterChoiceResult4(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("l"))
    }

    flow NameCharacterChoiceTest5(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 4)
    }

    flow NameCharacterChoiceResult5(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("o"))
    }

    flow NameCharacterChoiceTest6(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 5)
    }

    flow NameCharacterChoiceResult6(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("y"))
    }

    flow NameCharacterChoiceTest7(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 6)
    }

    flow NameCharacterChoiceResult7(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("m"))
    }

    flow NameCharacterChoiceTest8(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 7)
    }

    flow NameCharacterChoiceTest9(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 8)
    }

    flow NameCharacterChoiceResult9(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("n"))
    }

    flow NameCharacterChoiceTest10(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 9)
    }

    flow NameCharacterChoiceResult10(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("t"))
    }

    flow NameCharacterChoiceTest11(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, 10)
    }

    flow NameCharacterChoiceResult11(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("-"))
    }

    flow NameCharacterChoiceTest12(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, Math.sub(request.total, 4))
    }

    flow NameCharacterChoiceResult12(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("."))
    }

    flow NameCharacterChoiceTest13(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, Math.sub(request.total, 3))
    }

    flow NameCharacterChoiceTest14(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, Math.sub(request.total, 2))
    }

    flow NameCharacterChoiceTest15(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Math.eq(request.selector, Math.sub(request.total, 1))
    }

    flow NameCharacterChoiceResult15(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Scalar.eq(request.character, Scalar.new("g"))
    }

    flow NameCharacterChoiceDefault(request: Record{character: Scalar, selector: Int, total: Int}) -> Bool {
        return Range.contains(
                Range.new(Scalar.new("0"), Scalar.new("9"), true, true),
                request.character
            )
    }

    return Record.new(selector: index, character: character, total: total) |> Match.apply(Match.new(
        cases: List.new(
            Match.Case.new(NameCharacterChoiceTest1, NameCharacterChoiceResult1),
            Match.Case.new(NameCharacterChoiceTest2, NameCharacterChoiceResult2),
            Match.Case.new(NameCharacterChoiceTest3, NameCharacterChoiceResult3),
            Match.Case.new(NameCharacterChoiceTest4, NameCharacterChoiceResult4),
            Match.Case.new(NameCharacterChoiceTest5, NameCharacterChoiceResult5),
            Match.Case.new(NameCharacterChoiceTest6, NameCharacterChoiceResult6),
            Match.Case.new(NameCharacterChoiceTest7, NameCharacterChoiceResult7),
            Match.Case.new(NameCharacterChoiceTest8, NameCharacterChoiceResult2),
            Match.Case.new(NameCharacterChoiceTest9, NameCharacterChoiceResult9),
            Match.Case.new(NameCharacterChoiceTest10, NameCharacterChoiceResult10),
            Match.Case.new(NameCharacterChoiceTest11, NameCharacterChoiceResult11),
            Match.Case.new(NameCharacterChoiceTest12, NameCharacterChoiceResult12),
            Match.Case.new(NameCharacterChoiceTest13, NameCharacterChoiceResult4),
            Match.Case.new(NameCharacterChoiceTest14, NameCharacterChoiceResult5),
            Match.Case.new(NameCharacterChoiceTest15, NameCharacterChoiceResult15),
        ),
        default: NameCharacterChoiceDefault
    ))
}

flow NameStep(total: Int, state: Record{index: Int, valid: Bool}, character: Scalar) -> Record{index: Int, valid: Bool} {
    valid = Record.new(selector: state.valid, character: character, state: state, total: total) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(NameStepValidChoiceTest1, NameStepValidChoiceResult1)),
        default: NameStepValidChoiceDefault
    ))
    flow NameStepValidChoiceTest1(request: Record{character: Scalar, selector: Bool, state: Record{index: Int, valid: Bool}, total: Int}) -> Bool {
        return request.selector
    }

    flow NameStepValidChoiceResult1(request: Record{character: Scalar, selector: Bool, state: Record{index: Int, valid: Bool}, total: Int}) -> Bool {
        return NameCharacter(request.total, request.state.index, request.character)
    }

    flow NameStepValidChoiceDefault(request: Record{character: Scalar, selector: Bool, state: Record{index: Int, valid: Bool}, total: Int}) -> Bool {
        return false
    }

    return Record.new(index: Math.add(state.index, 1), valid: valid)
}

flow FullName(name: String, total: Int) -> Bool {
    initial = Record.new(index: 0, valid: true)
    result = List.fold(name, initial, total, NameStep)
    return result.valid
}

flow IsGatewayLogName(name: String) -> Bool {
    total = String.length(name)
    flow IsGatewayLogNameChoiceTest1(request: Record{name: String, selector: Bool, total: Int}) -> Bool {
        return request.selector
    }

    flow IsGatewayLogNameChoiceResult1(request: Record{name: String, selector: Bool, total: Int}) -> Bool {
        return FullName(request.name, request.total)
    }

    flow IsGatewayLogNameChoiceDefault(request: Record{name: String, selector: Bool, total: Int}) -> Bool {
        return false
    }

    return Record.new(selector: Math.gte(total, 16), name: name, total: total) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(IsGatewayLogNameChoiceTest1, IsGatewayLogNameChoiceResult1)),
        default: IsGatewayLogNameChoiceDefault
    ))
}

flow IsCandidate(cutoff_unix_ns: Int, entry: File.Entry) -> Bool {
    flow IsCandidateChoiceTest1(request: Record{cutoff_unix_ns: Int, entry: File.Entry, selector: String}) -> Bool {
        return String.eq(request.selector, "regular")
    }

    flow IsCandidateChoice2Test1(request: Record{cutoff_unix_ns: Int, entry: File.Entry, selector: Bool}) -> Bool {
        return request.selector
    }

    flow IsCandidateChoice2Result1(request: Record{cutoff_unix_ns: Int, entry: File.Entry, selector: Bool}) -> Bool {
        return Math.lt(request.entry.modified_unix_ns, request.cutoff_unix_ns)
    }

    flow IsCandidateChoice2Default(request: Record{cutoff_unix_ns: Int, entry: File.Entry, selector: Bool}) -> Bool {
        return false
    }

    flow IsCandidateChoiceResult1(request: Record{cutoff_unix_ns: Int, entry: File.Entry, selector: String}) -> Bool {
        return Record.new(selector: IsGatewayLogName(request.entry.name), cutoff_unix_ns: request.cutoff_unix_ns, entry: request.entry) |> Match.apply(Match.new(
            cases: List.new(Match.Case.new(IsCandidateChoice2Test1, IsCandidateChoice2Result1)),
            default: IsCandidateChoice2Default
        ))
    }

    flow IsCandidateChoiceDefault(request: Record{cutoff_unix_ns: Int, entry: File.Entry, selector: String}) -> Bool {
        return false
    }

    return Record.new(selector: entry.kind, cutoff_unix_ns: cutoff_unix_ns, entry: entry) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(IsCandidateChoiceTest1, IsCandidateChoiceResult1)),
        default: IsCandidateChoiceDefault
    ))
}

flow EmptyEntries() -> List<File.Entry> { return List.new() }

flow ListingError(error: Error) -> Record{directory_status: String, entries: List<File.Entry>!} {
    flow ListingErrorChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.DirectoryAbsent")
    }

    flow ListingErrorChoiceResult1(request: Record{error: Error, selector: String}) -> List<File.Entry>! {
        return EmptyEntries()
    }

    flow ListingErrorChoiceDefault(request: Record{error: Error, selector: String}) -> List<File.Entry>! {
        return request.error

    }

    return Record.new(directory_status: "absent", entries: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ListingErrorChoiceTest1, ListingErrorChoiceResult1)),
        default: ListingErrorChoiceDefault
    )))
}

flow Observe(root: File.Path) -> Record{directory_status: String, entries: List<File.Entry>!} onError ListingError {
    entries = File.list(root)
    return Record.new(directory_status: "present", entries: entries)
}

flow Select(root: File.Path, cutoff_unix_ns: Int) -> Record{directory_status: String, candidates: List<File.Entry>}! {
    observation = Observe(root)
    entries = observation.entries
    return Record.new(directory_status: observation.directory_status, candidates: entries |> List.filter(cutoff_unix_ns, IsCandidate))
}

flow SeenPath(target: File.Path, found: Bool, path: File.Path) -> Bool {
    flow SeenPathChoiceTest1(request: Record{path: File.Path, selector: Bool, target: File.Path}) -> Bool {
        return request.selector
    }

    flow SeenPathChoiceResult1(request: Record{path: File.Path, selector: Bool, target: File.Path}) -> Bool {
        return true
    }

    flow SeenPathChoiceDefault(request: Record{path: File.Path, selector: Bool, target: File.Path}) -> Bool {
        return File.Path.eq(request.path, request.target)
    }

    return Record.new(selector: found, path: path, target: target) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(SeenPathChoiceTest1, SeenPathChoiceResult1)),
        default: SeenPathChoiceDefault
    ))
}

flow Closed(open_paths: List<File.Path>, entry: File.Entry) -> Bool {
    opened = List.fold(open_paths, false, entry.path, SeenPath)
    flow ClosedChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow ClosedChoiceResult1(value: Bool) -> Bool {
        return false
    }

    flow ClosedChoiceDefault(value: Bool) -> Bool {
        return true
    }

    return opened |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ClosedChoiceTest1, ClosedChoiceResult1)),
        default: ClosedChoiceDefault
    ))
}

flow ProbeSelection(root: File.Path, candidates: List<File.Entry>) -> List<File.Entry>! {
    opened = File.open_paths(root)
    return candidates |> List.filter(opened, Closed)
}

flow Available(root: File.Path, candidates: List<File.Entry>) -> List<File.Entry>! {
    flow AvailableChoiceTest1(request: Record{candidates: List<File.Entry>, root: File.Path, selector: Int}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow AvailableChoiceResult1(request: Record{candidates: List<File.Entry>, root: File.Path, selector: Int}) -> List<File.Entry>! {
        return request.candidates
    }

    flow AvailableChoiceDefault(request: Record{candidates: List<File.Entry>, root: File.Path, selector: Int}) -> List<File.Entry>! {
        return ProbeSelection(request.root, request.candidates)
    }

    return Record.new(selector: List.length(candidates), candidates: candidates, root: root) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(AvailableChoiceTest1, AvailableChoiceResult1)),
        default: AvailableChoiceDefault
    ))
}

flow ObservedBytes(entry: File.Entry) -> Int { return entry.size_bytes }
flow CandidateName(entry: File.Entry) -> String { return entry.name }

flow Preview(root: File.Path, cutoff_unix_ns: Int) -> Record{directory_status: String, names: List<String>, selected_count: Int, observed_bytes: Int}! {
    observation = Select(root, cutoff_unix_ns)
    candidates = observation.candidates
    selected = Available(root, candidates)
    return Record.new(
        directory_status: observation.directory_status,
        names: selected |> List.map(CandidateName),
        selected_count: List.length(selected),
        observed_bytes: Math.sum(selected |> List.map(ObservedBytes))
    )
}

flow RemovalError(error: Error) -> Record{removed: Bool!} {
    flow RemovalErrorChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.EntryChanged")
    }

    flow RemovalErrorChoiceResult1(request: Record{error: Error, selector: String}) -> Bool! {
        return false
    }

    flow RemovalErrorChoiceDefault(request: Record{error: Error, selector: String}) -> Bool! {
        return request.error

    }

    return Record.new(removed: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RemovalErrorChoiceTest1, RemovalErrorChoiceResult1)),
        default: RemovalErrorChoiceDefault
    )))
}

flow RemoveOne(entry: File.Entry) -> Record{removed: Bool!} onError RemovalError {
    removal = File.Remove.new(List.new(entry))
    commit removal
    return Record.new(removed: true)
}

flow RemoveStep(state: Record{directory_status: String, removed_count: Int, observed_bytes: Int, skipped_count: Int}, entry: File.Entry) -> Record{directory_status: String, removed_count: Int, observed_bytes: Int, skipped_count: Int}! {
    outcome = RemoveOne(entry)
    removed = outcome.removed
    flow RemoveStepChoiceTest1(request: Record{entry: File.Entry, selector: Bool, state: Record{directory_status: String, observed_bytes: Int, removed_count: Int, skipped_count: Int}}) -> Bool {
        return request.selector
    }

    flow RemoveStepChoiceResult1(request: Record{entry: File.Entry, selector: Bool, state: Record{directory_status: String, observed_bytes: Int, removed_count: Int, skipped_count: Int}}) -> Record{directory_status: String, observed_bytes: Int, removed_count: Int, skipped_count: Int}! {
        return Record.new(directory_status: request.state.directory_status, removed_count: Math.add(request.state.removed_count, 1), observed_bytes: Math.add(request.state.observed_bytes, request.entry.size_bytes), skipped_count: request.state.skipped_count)
    }

    flow RemoveStepChoiceDefault(request: Record{entry: File.Entry, selector: Bool, state: Record{directory_status: String, observed_bytes: Int, removed_count: Int, skipped_count: Int}}) -> Record{directory_status: String, observed_bytes: Int, removed_count: Int, skipped_count: Int}! {
        return Record.new(directory_status: request.state.directory_status, removed_count: request.state.removed_count, observed_bytes: request.state.observed_bytes, skipped_count: Math.add(request.state.skipped_count, 1))
    }

    return Record.new(selector: removed, entry: entry, state: state) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RemoveStepChoiceTest1, RemoveStepChoiceResult1)),
        default: RemoveStepChoiceDefault
    ))
}

flow Cleanup(root: File.Path, cutoff_unix_ns: Int) -> Record{directory_status: String, removed_count: Int, observed_bytes: Int, skipped_count: Int}! {
    observation = Select(root, cutoff_unix_ns)
    candidates = observation.candidates
    selected = Available(root, candidates)
    initial = Record.new(directory_status: observation.directory_status, removed_count: 0, observed_bytes: 0, skipped_count: Math.sub(List.length(candidates), List.length(selected)))
    return Flow.fold(selected, initial, RemoveStep)
}

// Tests supply the root and cutoff. Preview uses: return Preview(root, cutoff_unix_ns)
root = File.Path.new("gateway-logs")
cutoff_unix_ns = Int.new(2000000000000000000)
return Cleanup(root, cutoff_unix_ns)
