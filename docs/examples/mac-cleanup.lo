// Each selected identifier invokes one branch callback through Flow.fold.
flow SelectedChoice(wanted: Int, candidate: Int) -> Bool { return Math.eq(wanted, candidate) }

flow ActionChoice1Branch1(arguments: List<String>, context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, executable: Process.Executable, previous: Int, selected: Int) -> Int! {
    return ApplyAction(context.process, executable, arguments)
}

flow ActionChoice1Branch2(previous: Int, selected: Int) -> Int! {
    return 0
}

flow CommandChoice1Branch1(task: Record{label: String, operation: String, path: File.Path, arguments: List<String>}, previous: Int, selected: Int) -> Int! {
    return SkipCommand(task)
}

flow CommandChoice1Branch2(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, executables: List<Process.Executable>, task: Record{label: String, operation: String, path: File.Path, arguments: List<String>}, previous: Int, selected: Int) -> Int! {
    return RunPresentCommand(context, task, List.at(executables, 0))
}

flow DetectPipChoice1Branch1(previous: List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>, selected: Int) -> List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>! {
    return List.new()
}

flow DetectPipChoice1Branch2(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, executables: List<Process.Executable>, previous: List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>, selected: Int) -> List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>! {
    return PipWithPython(context, List.at(executables, 0))
