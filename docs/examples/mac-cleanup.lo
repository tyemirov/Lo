    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), state, captured, context, state, XcodeChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, captured, state, XcodeChoice1Branch2)
    flow XcodeChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow XcodeChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow XcodeChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow SamePath(target: File.Path, found: Bool, path: File.Path) -> Bool {
    return Any(List.new(found, File.Path.eq(target, path)))
}

flow ReportPath(home: File.Path, relative: String) -> File.Path! { return File.Path.join(home, relative) }

flow ReportPathStep(home: File.Path, paths: List<File.Path>, relative: String) -> List<File.Path>! { return ConcatPaths(paths, List.new(ReportPath(home, relative))) }

flow StoragePaths(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}) -> List<File.Path>! {
    additional = List.new(
        "Library/Caches/go-build", "Library/Caches/Google", "Library/Caches/Firefox",
        "Library/Caches/Codex", "Library/Caches/com.openai.codex", "Library/Caches/Codex-codexw",
        "Library/Caches/lo", "Library/Caches/ms-playwright", "Library/Caches/lima",
        "Library/Developer/Xcode/DerivedData", "Library/Caches/node-gyp", "Library/Caches/CocoaPods",
        "Library/Caches/ReactNative", ".cache/zig", ".npm/_npx", "Library/Developer/CoreSimulator",
        ".gradle/caches", ".cache/huggingface", ".lmstudio", ".ollama", ".cache/whisper",
        ".cache/puppeteer", ".cache/codex-runtimes", ".cache/mprlab-gateway",
        "Library/Containers/com.docker.docker/Data/vms"
    )
    return ConcatPaths(CacheTargets(context), Flow.fold(additional, List.new(), context.home, ReportPathStep))
}

flow OptionalReportEntry(parent: File.Directory, name: String) -> Record{entries: List<File.Entry>!} onError AbsentBuildEntry {
    entry = File.Directory.entry(parent, name)
    return Record.new(entries: List.new(entry))
}
flow ReportEntryPath(paths: List<File.Path>, entry: File.Entry) -> List<File.Path> {
    flow ReportEntryPathChoiceTest1(request: Record{entry: File.Entry, paths: List<File.Path>, selector: Bool}) -> Bool {
        return request.selector
    }

    flow ReportEntryPathChoiceResult1(request: Record{entry: File.Entry, paths: List<File.Path>, selector: Bool}) -> List<File.Path> {
        return ConcatPaths(request.paths, List.new(request.entry.path))
    }

    flow ReportEntryPathChoiceDefault(request: Record{entry: File.Entry, paths: List<File.Path>, selector: Bool}) -> List<File.Path> {
        return request.paths
    }

    return Record.new(selector: StringMember(List.new("regular", "directory"), entry.kind), entry: entry, paths: paths) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ReportEntryPathChoiceTest1, ReportEntryPathChoiceResult1)),
        default: ReportEntryPathChoiceDefault
    ))
}
flow ReportParentPath(path: File.Path, paths: List<File.Path>, parent: File.Directory) -> List<File.Path>! {
    observed = OptionalReportEntry(parent, File.Path.name(path))
    return List.fold(observed.entries, paths, ReportEntryPath)
}
flow ExistingReportPath(paths: List<File.Path>, path: File.Path) -> List<File.Path>! {
    observed = OptionalDirectory(File.Path.parent(path))
    return Flow.fold(observed.directories, paths, path, ReportParentPath)
}

flow ParseStorageLine(line: String) -> Record{bytes: Int, path: String}! {
    fields = String.split_first(line, "\t")
    return Record.new(bytes: Math.mul(Int.parse(fields.before), 1024), path: fields.after)
}

flow CompareStorageRows(left: Record{bytes: Int, path: String}, right: Record{bytes: Int, path: String}) -> Int {
    flow CompareStorageRowsChoiceTest1(request: Record{left: Record{bytes: Int, path: String}, right: Record{bytes: Int, path: String}, selector: Bool}) -> Bool {
        return request.selector
    }

    flow CompareStorageRowsChoiceResult1(request: Record{left: Record{bytes: Int, path: String}, right: Record{bytes: Int, path: String}, selector: Bool}) -> Int {
        return Math.mul(-1, String.compare(request.left.path, request.right.path))
    }

    flow CompareStorageRowsChoice2Test1(value: Bool) -> Bool {
        return value
    }

    flow CompareStorageRowsChoice2Result1(value: Bool) -> Int {
        return -1
    }

    flow CompareStorageRowsChoice2Default(value: Bool) -> Int {
        return 1
    }

    flow CompareStorageRowsChoiceDefault(request: Record{left: Record{bytes: Int, path: String}, right: Record{bytes: Int, path: String}, selector: Bool}) -> Int {
        return Math.gt(request.left.bytes, request.right.bytes) |> Match.apply(Match.new(
            cases: List.new(Match.Case.new(CompareStorageRowsChoice2Test1, CompareStorageRowsChoice2Result1)),
            default: CompareStorageRowsChoice2Default
        ))
    }

    return Record.new(selector: Math.eq(left.bytes, right.bytes), left: left, right: right) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CompareStorageRowsChoiceTest1, CompareStorageRowsChoiceResult1)),
        default: CompareStorageRowsChoiceDefault
    ))
}

flow StorageLabel(targets: List<File.Path>, row: Record{bytes: Int, path: String}) -> String {
    base = List.fold(targets, false, File.Path.new(row.path), SamePath) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StorageLabelBaseChoiceTest1, StorageLabelBaseChoiceResult1)),
        default: StorageLabelBaseChoiceDefault
    ))
    flow StorageLabelBaseChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow StorageLabelBaseChoiceResult1(value: Bool) -> String {
        return "stale-cache cleanup"
    }

    flow StorageLabelBaseChoiceDefault(value: Bool) -> String {
        return "report only"
    }

    flow StorageLabelChoiceTest1(request: Record{base: String, row: Record{bytes: Int, path: String}, selector: Bool}) -> Bool {
        return request.selector
    }

    flow StorageLabelChoiceResult1(request: Record{base: String, row: Record{bytes: Int, path: String}, selector: Bool}) -> String {
        return "Go command cleanup"
    }

    flow StorageLabelChoice2Test1(request: Record{base: String, row: Record{bytes: Int, path: String}, selector: Bool}) -> Bool {
        return request.selector
    }

    flow StorageLabelChoice2Result1(request: Record{base: String, row: Record{bytes: Int, path: String}, selector: Bool}) -> String {
        return "whole stale build/cache trees only; SourcePackages preserved"
    }

    flow StorageLabelChoice3Test1(request: Record{base: String, selector: Bool}) -> Bool {
        return request.selector
    }

    flow StorageLabelChoice3Result1(request: Record{base: String, selector: Bool}) -> String {
        return "Docker image/build cleanup; host disk may not shrink immediately"
    }

    flow StorageLabelChoice3Default(request: Record{base: String, selector: Bool}) -> String {
        return request.base

    }

    flow StorageLabelChoice2Default(request: Record{base: String, row: Record{bytes: Int, path: String}, selector: Bool}) -> String {
        return Record.new(selector: String.ends_with(request.row.path, "/Data/vms"), base: request.base) |> Match.apply(Match.new(
            cases: List.new(Match.Case.new(StorageLabelChoice3Test1, StorageLabelChoice3Result1)),
            default: StorageLabelChoice3Default
        ))
    }

    flow StorageLabelChoiceDefault(request: Record{base: String, row: Record{bytes: Int, path: String}, selector: Bool}) -> String {
        return Record.new(selector: String.ends_with(request.row.path, "/Xcode/DerivedData"), base: request.base, row: request.row) |> Match.apply(Match.new(
            cases: List.new(Match.Case.new(StorageLabelChoice2Test1, StorageLabelChoice2Result1)),
            default: StorageLabelChoice2Default
        ))
    }

    return Record.new(selector: String.ends_with(row.path, "/Library/Caches/go-build"), base: base, row: row) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StorageLabelChoiceTest1, StorageLabelChoiceResult1)),
        default: StorageLabelChoiceDefault
    ))
}

flow StorageRowText(size: String, label: String, path: String) -> String! {
    return String.format("{size:>12}  [{label}] {path}", Record.new(size: size, label: label, path: path))
}

flow PrintStorageRow(targets: List<File.Path>, count: Int, row: Record{bytes: Int, path: String}) -> Int! {
    text = StorageRowText(HumanSize(row.bytes), StorageLabel(targets, row), row.path)
    printed = Print(text)
    return Math.add(count, 1)
}

flow StorageRowPath(row: Record{bytes: Int, path: String}) -> File.Path { return File.Path.new(row.path) }
flow StorageRowValid(paths: List<String>, row: Record{bytes: Int, path: String}) -> Bool {
    return All(List.new(Math.gte(row.bytes, 0), StringMember(paths, row.path)))
}

flow StorageInventory(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, paths: List<File.Path>, du: File.Path) -> Int! {
    executable = Process.Executable.new(du)
    result = RequireSuccess(Run(context.process, executable, ConcatStrings(List.new("-k", "-s"), List.map(paths, PathText)), "capture", 180))
    complete = Require(Math.eq(Bytes.length(result.stderr), 0), String.concat("Storage inventory incomplete: ", String.trim(String.FromBytes.new(result.stderr))))
    lines = String.lines(String.FromBytes.new(result.stdout))
    rows = Flow.fold(lines, List.new(), ParseStorageRows)
    valid = Require(All(List.new(Math.eq(List.length(rows), List.length(paths)), Math.eq(List.length(UniquePaths(List.map(rows, StorageRowPath))), List.length(paths)), All(List.map(rows, List.map(paths, PathText), StorageRowValid)))), "Storage inventory does not contain one nonnegative row for each selected path")
    printed = Print("Storage inventory (allocated size; NOT an estimate of reclaimable space):")
    count = Flow.fold(List.sort(rows, CompareStorageRows), 0, CacheTargets(context), PrintStorageRow)
    return 0
}

flow ParseStorageRows(rows: List<Record{bytes: Int, path: String}>, line: String) -> List<Record{bytes: Int, path: String}>! {
    row = ParseStorageLine(line)
    return ConcatStorageRows(rows, List.new(row))
}

flow StorageReport(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, du: File.Path) -> Int! {
    paths = Flow.fold(StoragePaths(context), List.new(), ExistingReportPath)
    selector_1 = List.length(paths)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StorageReportChoice_1ChoiceTest1, StorageReportChoice_1ChoiceResult1)),
        default: StorageReportChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, StorageReportChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, context, paths, du, StorageReportChoice1Branch2)
    flow StorageReportChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow StorageReportChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow StorageReportChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow SummaryFailure(state: Record{failures: List<String>, estimates: List<Int>}) -> Program.Exit! {
    printed = PrintError(String.concat("Failed categories: ", JoinStrings(state.failures, ", ")))
    return Program.Exit.new(1, Bytes.new(""), Bytes.new(""))
}

flow SummarySuccess(apply: Bool) -> Program.Exit! {
    printed = Print(apply |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(SummarySuccessPrintedChoiceTest1, SummarySuccessPrintedChoiceResult1)),
        default: SummarySuccessPrintedChoiceDefault
    )))
    flow SummarySuccessPrintedChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow SummarySuccessPrintedChoiceResult1(value: Bool) -> String {
        return "Cleanup complete"
    }

    flow SummarySuccessPrintedChoiceDefault(value: Bool) -> String {
        return "Preview complete; nothing deleted"
    }

    return Program.Exit.new(0, Bytes.new(""), Bytes.new(""))
}

flow Finish(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, before: Int, state: Record{failures: List<String>, estimates: List<Int>}) -> Program.Exit! {
    preserved = Print("Gateway lifecycle records, installed runtimes and operator state: preserved")
    after = File.System.usage(context.home)
    printed = Print(String.concat("Free disk space now: ", HumanSize(after.free_bytes), "; net volume change: ", HumanSize(Math.sub(after.free_bytes, before)), " (includes concurrent activity and APFS effects)"))
    selector_1 = List.length(state.failures)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(FinishChoice_1ChoiceTest1, FinishChoice_1ChoiceResult1)),
        default: FinishChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), Program.Exit.new(0, Bytes.new(""), Bytes.new("")), context, FinishChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, state, FinishChoice1Branch2)
    flow FinishChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow FinishChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow FinishChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow PlanNotice(apply: Bool) -> Bool! {
    selector_1 = apply
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(PlanNoticeChoice_1ChoiceTest1, PlanNoticeChoice_1ChoiceResult1)),
        default: PlanNoticeChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), false, PlanNoticeChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, PlanNoticeChoice1Branch2)
    flow PlanNoticeChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow PlanNoticeChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow PlanNoticeChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow UnknownEstimate(apply: Bool) -> Bool! {
    selector_1 = apply
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(UnknownEstimateChoice_1ChoiceTest1, UnknownEstimateChoice_1ChoiceResult1)),
        default: UnknownEstimateChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), false, UnknownEstimateChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, UnknownEstimateChoice1Branch2)
    flow UnknownEstimateChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow UnknownEstimateChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow UnknownEstimateChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow Workflow(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, before: Int, settings: Record{shared_temp: File.Path, user_temp_prefix: String, getconf: File.Path, du: File.Path}) -> Program.Exit! {
    notice = PlanNotice(context.apply)
    pip = TryPreparePip(context)
    initial = InitialWorkflow()
    selector_1 = List.length(pip.errors)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(WorkflowChoice_1ChoiceTest1, WorkflowChoice_1ChoiceResult1)),
        default: WorkflowChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), initial, initial, WorkflowChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, initial, pip, WorkflowChoice1Branch2)
    pip_state = choice_1_result_2
    pip_tasks = TaskGroup(WorkflowPip_tasksChoiceValue(Record.new(selector: List.length(pip.errors), pip: pip) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(WorkflowPip_tasksChoiceTest1, WorkflowPip_tasksChoiceResult1)),
        default: WorkflowPip_tasksChoiceDefault
    ))))
    commands = Flow.fold(ConcatTasks(CommandTasks(), pip_tasks), pip_state, context, Attempt)
    logs = Task("npm logs", "files", File.Path.join(context.home, ".npm/_logs"), List.new())
    with_logs = Attempt(context, commands, logs)
    caches = Flow.fold(List.map(CacheTargets(context), CacheTask), with_logs, context, Attempt)
    trees = Xcode(context, caches)
    printed = Print(String.concat("Observed allocation across completed cache scans and build trees: ", HumanSize(Math.sum(trees.estimates))))
    unknown = UnknownEstimate(context.apply)
    remaining = List.new(
        Task("Temporary files", "temp", settings.shared_temp, List.new(settings.user_temp_prefix, PathText(settings.getconf))),
        Task("Docker", "docker", File.Path.new("."), List.new()),
        Task("Gateway logs", "logs", File.Path.new("."), List.new())
    )
    completed = Flow.fold(remaining, trees, context, Attempt)
    flow WorkflowChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow WorkflowChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow WorkflowChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    flow WorkflowPip_tasksChoiceTest1(request: Record{pip: Record{errors: List<Error>, result: List<Record{arguments: List<String>, label: String, operation: String, path: File.Path}>!}, selector: Int}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow WorkflowPip_tasksChoiceResult1(request: Record{pip: Record{errors: List<Error>, result: List<Record{arguments: List<String>, label: String, operation: String, path: File.Path}>!}, selector: Int}) -> List<Record{arguments: List<String>, label: String, operation: String, path: File.Path}>! {
        return request.pip.result
    }

    flow WorkflowPip_tasksChoiceDefault(request: Record{pip: Record{errors: List<Error>, result: List<Record{arguments: List<String>, label: String, operation: String, path: File.Path}>!}, selector: Int}) -> List<Record{arguments: List<String>, label: String, operation: String, path: File.Path}>! {
        return List.new()
    }

    flow WorkflowPip_tasksChoiceValue(value: List<Record{arguments: List<String>, label: String, operation: String, path: File.Path}>) -> List<Record{arguments: List<String>, label: String, operation: String, path: File.Path}> { return value }

    return Finish(context, before, completed)
}

flow PreparePip(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}) -> List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>! {
    selector_1 = context.apply
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(PreparePipChoice_1ChoiceTest1, PreparePipChoice_1ChoiceResult1)),
        default: PreparePipChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), List.new(), context, PreparePipChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, PreparePipChoice1Branch2)
    flow PreparePipChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow PreparePipChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow PreparePipChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow Report(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, du: File.Path) -> Program.Exit! {
    captured = TryStorageReport(context, du)
    selector_1 = List.length(captured.errors)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ReportChoice_1ChoiceTest1, ReportChoice_1ChoiceResult1)),
        default: ReportChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), false, ReportChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, captured, ReportChoice1Branch2)
    failed = choice_1_result_2
    flow ReportChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow ReportChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow ReportChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    flow ReportChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow ReportChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow ReportChoiceDefault(value: Bool) -> Int {
        return 0
    }

    return Program.Exit.new(failed |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ReportChoiceTest1, ReportChoiceResult1)),
        default: ReportChoiceDefault
    )), Bytes.new(""), Bytes.new(""))
}

flow ReportFailure(error: Error) -> Bool! {
    printed = PrintError(String.concat("FAILED Storage report: ", error.message))
    return true
}

flow Started(invocation: Host.Invocation, options: CLI.Options, settings: Record{shared_temp: File.Path, user_temp_prefix: String, getconf: File.Path, du: File.Path}) -> Program.Exit! {
    printed = Print("Starting mac-cleanup")
    before = File.System.usage(invocation.home)
    free_bytes = before.free_bytes
    free = Print(String.concat("Free disk space: ", HumanSize(free_bytes)))
    inherited = Process.Context.current()
    process = Process.Context.override_environment(inherited, Map.new(
        Record.new(key: "CI", value: "1"),
        Record.new(key: "HOMEBREW_NO_AUTO_UPDATE", value: "1"),
        Record.new(key: "HOMEBREW_NO_ANALYTICS", value: "1"),
        Record.new(key: "GOTOOLCHAIN", value: "local"),
        Record.new(key: "MISE_AUTO_INSTALL", value: "0"),
        Record.new(key: "UV_PYTHON_DOWNLOADS", value: "never")
    ))
    report = Map.get(options.flags, "--report")
    dry_run = Map.get(options.flags, "--dry-run")
    context = Record.new(apply: Not(Any(List.new(report, dry_run))), home: invocation.home, uid: invocation.real_uid, process: process)
    selector_1 = report
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StartedChoice_1ChoiceTest1, StartedChoice_1ChoiceResult1)),
        default: StartedChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), Program.Exit.new(0, Bytes.new(""), Bytes.new("")), context, settings.du, StartedChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, free_bytes, context, settings, StartedChoice1Branch2)
    flow StartedChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow StartedChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow StartedChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow Locked(invocation: Host.Invocation, options: CLI.Options, settings: Record{shared_temp: File.Path, user_temp_prefix: String, getconf: File.Path, du: File.Path}) -> Program.Exit! {
    lock = Lock.File.new(Program.path())
    lease = commit lock
    selector_1 = invocation.effective_uid
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(LockedChoice_1ChoiceTest1, LockedChoice_1ChoiceResult1)),
        default: LockedChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), Program.Exit.new(0, Bytes.new(""), Bytes.new("")), LockedChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, invocation, options, settings, LockedChoice1Branch2)
    flow LockedChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow LockedChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow LockedChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow StartupFailure(error: Error) -> Record{results: List<Program.Exit>, code: Int, message: String} {
    code = error.kind |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StartupFailureCodeChoiceTest1, StartupFailureCodeChoiceResult1)),
        default: StartupFailureCodeChoiceDefault
    ))
    message = Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StartupFailureMessageChoiceTest1, StartupFailureMessageChoiceResult1)),
        default: StartupFailureMessageChoiceDefault
    ))
    flow StartupFailureCodeChoiceTest1(value: String) -> Bool {
        return String.eq(value, "CLI.InvalidArguments")
    }

    flow StartupFailureCodeChoiceResult1(value: String) -> Int {
        return 2
    }

    flow StartupFailureCodeChoiceDefault(value: String) -> Int {
        return 1
    }

    flow StartupFailureMessageChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "Lock.Busy")
    }

    flow StartupFailureMessageChoiceResult1(request: Record{error: Error, selector: String}) -> String {
        return "Another cleanup instance is running"
    }

    flow StartupFailureMessageChoiceDefault(request: Record{error: Error, selector: String}) -> String {
        return request.error.message
    }

    return Record.new(results: List.new(), code: code, message: message)
}

flow ArgumentFlags() -> List<Record{name: String, aliases: List<String>, group: String, help: String}> {
    return List.new(
        Record.new(name: "--dry-run", aliases: List.new(), group: "mode", help: "preview without deleting files or running cleaners"),
        Record.new(name: "--report", aliases: List.new(), group: "mode", help: "show storage inventory without cleanup")
    )
}

flow Startup(settings: Record{shared_temp: File.Path, user_temp_prefix: String, getconf: File.Path, du: File.Path}) -> Record{results: List<Program.Exit>, code: Int, message: String} onError StartupFailure {
    invocation = Host.Invocation.current()
    flags = ArgumentFlags()
    options = CLI.parse(invocation.arguments, flags, "mac-cleanup", "Clean known macOS development caches; optional read-only preview/report.", true)
    selector_1 = options.help_requested
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StartupChoice_1ChoiceTest1, StartupChoice_1ChoiceResult1)),
        default: StartupChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), Program.Exit.new(0, Bytes.new(""), Bytes.new("")), options, MainChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, invocation, options, settings, MainChoice1Branch2)
    flow StartupChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow StartupChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow StartupChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return Record.new(results: List.new(choice_1_result_2), code: 0, message: "")
}

flow MainWithSettings(settings: Record{shared_temp: File.Path, user_temp_prefix: String, getconf: File.Path, du: File.Path}) -> Program.Exit! {
    startup = Startup(settings)
    flow MainWithSettingsChoiceTest1(request: Record{selector: Int, startup: Record{code: Int, message: String, results: List<Program.Exit>}}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow MainWithSettingsChoiceResult1(request: Record{selector: Int, startup: Record{code: Int, message: String, results: List<Program.Exit>}}) -> Program.Exit! {
        return Program.Exit.new(request.startup.code, Bytes.new(""), Bytes.new(String.concat(request.startup.message, "\n")))
    }

    flow MainWithSettingsChoiceDefault(request: Record{selector: Int, startup: Record{code: Int, message: String, results: List<Program.Exit>}}) -> Program.Exit! {
        return List.at(request.startup.results, 0)
    }

    return Record.new(selector: List.length(startup.results), startup: startup) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(MainWithSettingsChoiceTest1, MainWithSettingsChoiceResult1)),
        default: MainWithSettingsChoiceDefault
    ))
}

// File-selection, retained-directory, recursive-cache, and whole-tree flows
// follow below. All application policy stays in these named Lo flows.

flow EntryPath(entry: File.Entry) -> File.Path { return entry.path }
flow EntryBytes(entry: File.Entry) -> Int { return entry.size_bytes }
flow EntryAllocation(entry: File.Entry) -> Int { return entry.allocated_bytes }
flow PathString(path: File.Path) -> String { return File.Path.to_string(path) }
flow Cutoff(days: Int) -> Int! { return Math.sub(Clock.now_unix_ns(), Math.mul(days, 86400000000000)) }
flow SameDirectory(before: File.Directory, after: File.Directory) -> Bool {
    return All(List.new(File.Path.eq(before.path, after.path), Math.eq(before.device, after.device), Math.eq(before.inode, after.inode)))
}
flow SameFile(before: File.Entry, after: File.Entry) -> Bool {
    return All(List.new(Math.eq(before.device, after.device), Math.eq(before.inode, after.inode), String.eq(before.kind, after.kind), Math.eq(before.owner_uid, after.owner_uid), Math.eq(before.link_count, after.link_count), Math.eq(before.size_bytes, after.size_bytes), Math.eq(before.accessed_unix_ns, after.accessed_unix_ns), Math.eq(before.modified_unix_ns, after.modified_unix_ns), Math.eq(before.changed_unix_ns, after.changed_unix_ns)))
}
flow OldFile(cutoff: Int, entry: File.Entry) -> Bool {
    return All(List.new(Math.lt(entry.accessed_unix_ns, cutoff), Math.lt(entry.modified_unix_ns, cutoff), Math.lt(entry.changed_unix_ns, cutoff)))
}
flow SafeCharacter(character: Scalar) -> Bool {
    return Any(List.new(Range.contains(Range.new(Scalar.new("A"), Scalar.new("Z"), true, true), character), Range.contains(Range.new(Scalar.new("a"), Scalar.new("z"), true, true), character), Range.contains(Range.new(Scalar.new("0"), Scalar.new("9"), true, true), character), ScalarMember(List.new(Scalar.new("/"), Scalar.new("."), Scalar.new("_"), Scalar.new(" "), Scalar.new("-")), character)))
}
flow SafePath(path: File.Path) -> Bool { return All(List.map(File.Path.to_string(path), SafeCharacter)) }
flow UnambiguousCharacter(character: Scalar) -> Bool {
    return All(List.new(Not(Range.contains(Range.new(Scalar.new("\u0000"), Scalar.new("\u001f"), true, true), character)), Not(Scalar.eq(character, Scalar.new("\u007f"))), Not(Scalar.eq(character, Scalar.new("\\")))))
}
flow UnambiguousPath(entry: File.Entry) -> Bool { return All(List.map(File.Path.to_string(entry.path), UnambiguousCharacter)) }
flow MaskMatches(name: String, mask: Glob) -> Bool { return Glob.matches(mask, name) }
flow CompileMasks(previous: List<Glob>, mask: String) -> List<Glob>! { return ConcatGlobs(previous, List.new(Glob.new(mask))) }
flow StaleCandidate(uid: Int, cutoff: Int, masks: List<Glob>, entry: File.Entry) -> Bool {
    return All(List.new(SafePath(entry.path), Not(String.starts_with(entry.name, ".")), Any(List.map(masks, entry.name, MaskMatches)), String.eq(entry.kind, "regular"), Math.eq(entry.owner_uid, uid), Math.eq(entry.link_count, 1), OldFile(cutoff, entry)))
}
flow StaleGuard(uid: Int, cutoff: Int, masks: List<Glob>, before: File.Entry, now: File.Entry) -> Bool {
    return All(List.new(SameFile(before, now), StaleCandidate(uid, cutoff, masks, now)))
}
flow GatewayDigit(valid: Bool, character: Scalar) -> Bool {
    flow GatewayDigitChoiceTest1(request: Record{character: Scalar, selector: Bool}) -> Bool {
        return request.selector
    }

    flow GatewayDigitChoiceResult1(request: Record{character: Scalar, selector: Bool}) -> Bool {
        return Range.contains(Range.new(Scalar.new("0"), Scalar.new("9"), true, true), request.character)
    }

    flow GatewayDigitChoiceDefault(request: Record{character: Scalar, selector: Bool}) -> Bool {
        return false
    }

    return Record.new(selector: valid, character: character) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(GatewayDigitChoiceTest1, GatewayDigitChoiceResult1)),
        default: GatewayDigitChoiceDefault
    ))
}
flow GatewayDigits(name: String) -> Bool! {
    digits = String.slice(name, 11, Math.sub(String.length(name), 4))
    return List.fold(digits, true, GatewayDigit)
}
flow GatewayName(name: String) -> Bool! {
    flow GatewayNameChoiceTest1(request: Record{name: String, selector: Bool}) -> Bool {
        return request.selector
    }

    flow GatewayNameChoiceResult1(request: Record{name: String, selector: Bool}) -> Bool! {
        return GatewayDigits(request.name)
    }

    flow GatewayNameChoiceDefault(request: Record{name: String, selector: Bool}) -> Bool! {
        return false
    }

    return Record.new(selector: Math.gte(String.length(name), 16), name: name) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(GatewayNameChoiceTest1, GatewayNameChoiceResult1)),
        default: GatewayNameChoiceDefault
    ))
}
flow GatewayCandidate(cutoff: Int, mask: Glob, entry: File.Entry) -> Bool! {
    return All(List.new(Glob.matches(mask, entry.name), GatewayName(entry.name), String.eq(entry.kind, "regular"), Math.lt(entry.modified_unix_ns, cutoff)))
}
flow GatewayGuard(before: File.Entry, now: File.Entry) -> Bool {
    return All(List.new(Math.eq(before.device, now.device), Math.eq(before.inode, now.inode), String.eq(before.kind, now.kind), Math.eq(before.size_bytes, now.size_bytes), Math.eq(before.modified_unix_ns, now.modified_unix_ns)))
}
flow FileChanged(error: Error) -> Record{removed: Bool!} {
    flow FileChangedChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.EntryChanged")
    }

    flow FileChangedChoiceResult1(request: Record{error: Error, selector: String}) -> Bool! {
        return false
    }

    flow FileChangedChoiceDefault(request: Record{error: Error, selector: String}) -> Bool! {
        return request.error
    }

    return Record.new(removed: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(FileChangedChoiceTest1, FileChangedChoiceResult1)),
        default: FileChangedChoiceDefault
    )))
}
flow CommitStale(uid: Int, cutoff: Int, masks: List<Glob>, entry: File.Entry) -> Record{removed: Bool!} onError FileChanged {
    target = File.Remove.checked(List.new(entry), uid, cutoff, masks, StaleGuard)
    commit target
    return Record.new(removed: true)
}
flow CommitGateway(entry: File.Entry) -> Record{removed: Bool!} onError FileChanged {
    target = File.Remove.checked(List.new(entry), GatewayGuard)
    commit target
    return Record.new(removed: true)
}
flow PrintCandidate(previous: Bool, entry: File.Entry) -> Bool! { return Print(String.concat("CANDIDATE ", File.Path.to_string(entry.path))) }
flow RequireOpenFiles(condition: Bool, message: String) -> Bool! {
    flow RequireOpenFilesChoiceTest1(request: Record{message: String, selector: Bool}) -> Bool {
        return request.selector
    }

    flow RequireOpenFilesChoiceResult1(request: Record{message: String, selector: Bool}) -> Bool! {
        return true
    }

    flow RequireOpenFilesChoiceDefault(request: Record{message: String, selector: Bool}) -> Bool! {
        return Error.new("Cleanup.OpenFiles", request.message, Record.new())
    }

    return Record.new(selector: condition, message: message) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RequireOpenFilesChoiceTest1, RequireOpenFilesChoiceResult1)),
        default: RequireOpenFilesChoiceDefault
    ))
}
flow RemovalSkipped(removed: Bool, entry: File.Entry) -> Bool { return Not(removed) }
flow LsofStatus(result: Process.Result) -> Bool! {
    code = Process.Termination.exit_code(result.termination)
    flow LsofStatusChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow LsofStatusChoiceResult1(value: Bool) -> Bool! {
        return true
    }

    flow LsofStatusChoiceDefault(value: Bool) -> Bool! {
        return Error.new("Cleanup.OpenFiles", "Cannot verify open files; stopping category", Record.new())
    }

    return IntMember(List.new(0, 1), code) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(LsofStatusChoiceTest1, LsofStatusChoiceResult1)),
        default: LsofStatusChoiceDefault
    ))
}
flow ProbeFieldText(field: Bytes) -> String! {
    clean = Record.new(selector: Bytes.starts_with(field, Bytes.new("\n")), field: field) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ProbeFieldTextCleanChoiceTest1, ProbeFieldTextCleanChoiceResult1)),
        default: ProbeFieldTextCleanChoiceDefault
    ))
    text = String.FromBytes.new(clean)
    valid = All(List.new(Math.gt(String.length(text), 1), Math.eq(List.length(String.split(text, "\n")), 1), Math.eq(List.length(String.split(text, "\r")), 1), Any(List.new(String.starts_with(text, "p"), String.starts_with(text, "f"), String.starts_with(text, "n")))))
    checked = RequireOpenFiles(valid, "Malformed open-file field; stopping category")
    flow ProbeFieldTextCleanChoiceTest1(request: Record{field: Bytes, selector: Bool}) -> Bool {
        return request.selector
    }

    flow ProbeFieldTextCleanChoiceResult1(request: Record{field: Bytes, selector: Bool}) -> Bytes! {
        return Bytes.slice(request.field, 1, Bytes.length(request.field))
    }

    flow ProbeFieldTextCleanChoiceDefault(request: Record{field: Bytes, selector: Bool}) -> Bytes! {
        return request.field
    }

    return text
}
flow ProbePIDValid(field: String) -> Bool! {
    flow ProbePIDValidChoiceTest1(request: Record{field: String, selector: Bool}) -> Bool {
        return request.selector
    }

    flow ProbePIDValidChoiceResult1(request: Record{field: String, selector: Bool}) -> Bool! {
        return List.fold(String.slice(request.field, 1, String.length(request.field)), true, GatewayDigit)
    }

    flow ProbePIDValidChoiceDefault(request: Record{field: String, selector: Bool}) -> Bool! {
        return true
    }

    return Record.new(selector: String.starts_with(field, "p"), field: field) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ProbePIDValidChoiceTest1, ProbePIDValidChoiceResult1)),
        default: ProbePIDValidChoiceDefault
    ))
}
flow FieldName(field: Bytes) -> List<File.Path>! {
    text = ProbeFieldText(field)
    checked = RequireOpenFiles(ProbePIDValid(text), "Malformed open-file process identifier; stopping category")
    flow FieldNameChoiceTest1(request: Record{selector: Bool, text: String}) -> Bool {
        return request.selector
    }

    flow FieldNameChoiceResult1(request: Record{selector: Bool, text: String}) -> List<File.Path>! {
        return List.new(File.Path.new(String.slice(request.text, 1, String.length(request.text))))
    }

    flow FieldNameChoiceDefault(request: Record{selector: Bool, text: String}) -> List<File.Path>! {
        return List.new()
    }

    return Record.new(selector: String.starts_with(text, "n"), text: text) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(FieldNameChoiceTest1, FieldNameChoiceResult1)),
        default: FieldNameChoiceDefault
    ))
}
flow ParseNames(previous: List<File.Path>, field: Bytes) -> List<File.Path>! { return ConcatPaths(previous, FieldName(field)) }
flow BatchNames(result: Process.Result) -> List<File.Path>! {
    accepted = LsofStatus(result)
    checked = RequireOpenFiles(Math.eq(Bytes.length(result.stderr), 0), "Cannot verify open files; stopping category")
    fields = Bytes.split(result.stdout, Bytes.new("\u0000"))
    last = Math.sub(List.length(fields), 1)
    trailer = String.FromBytes.new(List.at(fields, last))
    framed = RequireOpenFiles(Any(List.new(String.eq(trailer, ""), String.eq(trailer, "\n"))), "Malformed open-file framing; stopping category")
    names = Flow.fold(List.slice(fields, 0, last), List.new(), ParseNames)
    named = RequireOpenFiles(Any(List.new(Math.eq(Bytes.length(result.stdout), 0), Math.gt(List.length(names), 0))), "Open-file output has no file names; stopping category")
    return names
}
flow KnownOpen(batch: List<File.Path>, path: File.Path) -> Bool { return PathMember(batch, path) }
flow ProbeBatch(context: Process.Context, opened: List<File.Path>, batch: List<File.Path>) -> List<File.Path>! {
    executable = Lsof(context)
    result = Run(context, executable, ConcatStrings(List.new("-F0n", "--"), List.map(batch, PathString)), "capture", 30)
    names = BatchNames(result)
    valid = All(List.map(names, batch, KnownOpen))
    checked = RequireOpenFiles(valid, "Ambiguous open-file result; stopping category")
    return UniquePaths(ConcatPaths(opened, names))
}
flow OpenedPaths(context: Process.Context, paths: List<File.Path>) -> List<File.Path>! {
    return Flow.fold(PathChunks(paths, 100), List.new(), context, ProbeBatch)
}
flow RemoveStaleStep(uid: Int, cutoff: Int, masks: List<Glob>, opened: List<File.Path>, deleted: Int, entry: File.Entry) -> Int! {
    selector_1 = PathMember(opened, entry.path)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RemoveStaleStepChoice_1ChoiceTest1, RemoveStaleStepChoice_1ChoiceResult1)),
        default: RemoveStaleStepChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, deleted, entry, RemoveStaleStepChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, cutoff, deleted, entry, masks, uid, RemoveStaleStepChoice1Branch2)
    flow RemoveStaleStepChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow RemoveStaleStepChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow RemoveStaleStepChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow SkipStaleOpen(deleted: Int, entry: File.Entry) -> Int! {
    printed = Print(String.concat("SKIP open file: ", File.Path.to_string(entry.path)))
    return deleted
}
flow RemoveStaleClosed(uid: Int, cutoff: Int, masks: List<Glob>, deleted: Int, entry: File.Entry) -> Int! {
    outcome = CommitStale(uid, cutoff, masks, entry)
    removed = outcome.removed
    count = Record.new(selector: removed, deleted: deleted) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RemoveStaleClosedCountChoiceTest1, RemoveStaleClosedCountChoiceResult1)),
        default: RemoveStaleClosedCountChoiceDefault
    ))
    flow RemoveStaleClosedCountChoiceTest1(request: Record{deleted: Int, selector: Bool}) -> Bool {
        return request.selector
    }

    flow RemoveStaleClosedCountChoiceResult1(request: Record{deleted: Int, selector: Bool}) -> Int {
        return Math.add(request.deleted, 1)
    }

    flow RemoveStaleClosedCountChoiceDefault(request: Record{deleted: Int, selector: Bool}) -> Int {
        return request.deleted
    }

    return Flow.fold(List.filter(List.new(entry), removed, RemovalSkipped), count, ChangedStale)
}



flow ChangedStale(deleted: Int, entry: File.Entry) -> Int! {
    printed = Print(String.concat("SKIP changed file: ", File.Path.to_string(entry.path)))
    return deleted
}
flow ApplyStale(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, cutoff: Int, masks: List<Glob>, candidates: List<File.Entry>) -> Int! {
    opened = OpenedPaths(context.process, List.map(candidates, EntryPath))
    deleted = Flow.fold(candidates, 0, context.uid, cutoff, masks, opened, RemoveStaleStep)
    printed = Print(String.concat("Deleted ", Int.to_string(deleted), " files from ", PathText(folder)))
    return 0
}
flow StaleFilesPresent(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, mask_text: List<String>, days: Int, previous: Int, scan: File.Scan) -> Int! {
    cutoff = Cutoff(days)
    masks = Flow.fold(mask_text, List.new(), CompileMasks)
    candidates = List.filter(scan.entries, context.uid, cutoff, masks, StaleCandidate)
    printed = Print(String.concat(PathText(folder), ": ", Int.to_string(List.length(candidates)), " eligible files, ", Int.to_string(Math.sum(List.map(candidates, EntryBytes))), " bytes; age > ", Int.to_string(days), " days"))
    listed = Flow.fold(candidates, true, PrintCandidate)
    selector_1 = All(List.new(context.apply, Math.gt(List.length(candidates), 0)))
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StaleFilesPresentChoice_1ChoiceTest1, StaleFilesPresentChoice_1ChoiceResult1)),
        default: StaleFilesPresentChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, candidates, context, cutoff, folder, masks, StaleFilesPresentChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, StaleFilesPresentChoice1Branch2)
    flow StaleFilesPresentChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow StaleFilesPresentChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow StaleFilesPresentChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow AbsentScan(error: Error) -> Record{scans: List<File.Scan>!} {
    flow AbsentScanChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.DirectoryAbsent")
    }

    flow AbsentScanChoiceResult1(request: Record{error: Error, selector: String}) -> List<File.Scan>! {
        return List.new()
    }

    flow AbsentScanChoiceDefault(request: Record{error: Error, selector: String}) -> List<File.Scan>! {
        return request.error
    }

    return Record.new(scans: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(AbsentScanChoiceTest1, AbsentScanChoiceResult1)),
        default: AbsentScanChoiceDefault
    )))
}
flow OptionalScan(folder: File.Path) -> Record{scans: List<File.Scan>!} onError AbsentScan {
    scan = File.scan(folder)
    return Record.new(scans: List.new(scan))
}
flow SkipAbsentScan(folder: File.Path, previous: Int, selected: Int) -> Int! { return SkipAbsentDirectory(folder) }
flow StaleFiles(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, masks: List<String>, days: Int) -> Int! {
    observation = OptionalScan(folder)
    scans = observation.scans
    absent = Flow.fold(List.filter(List.new(List.length(scans)), 0, SelectedChoice), 0, folder, SkipAbsentScan)
    return Flow.fold(scans, absent, context, folder, masks, days, StaleFilesPresent)
}

flow SkipAbsentDirectory(folder: File.Path) -> Int! {
    printed = Print(String.concat("SKIP absent directory: ", File.Path.to_string(folder)))
    return 0
}
flow GatewayLine(line: String) -> List<File.Path>! {
    flow GatewayLineChoiceTest1(request: Record{line: String, selector: Bool}) -> Bool {
        return request.selector
    }

    flow GatewayLineChoiceResult1(request: Record{line: String, selector: Bool}) -> List<File.Path>! {
        return List.new(File.Path.new(String.slice(request.line, 1, String.length(request.line))))
    }

    flow GatewayLineChoiceDefault(request: Record{line: String, selector: Bool}) -> List<File.Path>! {
        return List.new()
    }

    return Record.new(selector: String.starts_with(line, "n"), line: line) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(GatewayLineChoiceTest1, GatewayLineChoiceResult1)),
        default: GatewayLineChoiceDefault
    ))
}
flow GatewayLineStep(paths: List<File.Path>, line: String) -> List<File.Path>! { return ConcatPaths(paths, GatewayLine(line)) }
flow GatewayOpened(context: Process.Context, folder: File.Path) -> List<File.Path>! {
    result = Run(context, Lsof(context), List.new("-Fn", "+D", File.Path.to_string(folder)), "capture", 30)
    accepted = LsofStatus(result)
    checked = RequireOpenFiles(String.eq(String.trim(String.FromBytes.new(result.stderr)), ""), String.concat("Cannot verify open Gateway logs: ", String.trim(String.FromBytes.new(result.stderr))))
    return Flow.fold(String.lines(String.FromBytes.new(result.stdout)), List.new(), GatewayLineStep)
}
flow GatewayRemove(opened: List<File.Path>, deleted: Int, entry: File.Entry) -> Int! {
    selector_1 = PathMember(opened, entry.path)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(GatewayRemoveChoice_1ChoiceTest1, GatewayRemoveChoice_1ChoiceResult1)),
        default: GatewayRemoveChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, deleted, entry, GatewayRemoveChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, deleted, entry, GatewayRemoveChoice1Branch2)
    flow GatewayRemoveChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow GatewayRemoveChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow GatewayRemoveChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow GatewaySkipOpen(deleted: Int, entry: File.Entry) -> Int! {
    printed = Print(String.concat("SKIP open log: ", File.Path.to_string(entry.path)))
    return deleted
}
flow GatewayRemoveClosed(deleted: Int, entry: File.Entry) -> Int! {
    outcome = CommitGateway(entry)
    removed = outcome.removed
    count = Record.new(selector: removed, deleted: deleted) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(GatewayRemoveClosedCountChoiceTest1, GatewayRemoveClosedCountChoiceResult1)),
        default: GatewayRemoveClosedCountChoiceDefault
    ))
    flow GatewayRemoveClosedCountChoiceTest1(request: Record{deleted: Int, selector: Bool}) -> Bool {
        return request.selector
    }

    flow GatewayRemoveClosedCountChoiceResult1(request: Record{deleted: Int, selector: Bool}) -> Int {
        return Math.add(request.deleted, 1)
    }

    flow GatewayRemoveClosedCountChoiceDefault(request: Record{deleted: Int, selector: Bool}) -> Int {
        return request.deleted
    }

    return Flow.fold(List.filter(List.new(entry), removed, RemovalSkipped), count, GatewayChanged)
}



flow GatewayChanged(deleted: Int, entry: File.Entry) -> Int! {
    printed = Print(String.concat("SKIP changed log: ", File.Path.to_string(entry.path)))
    return deleted
}
flow GatewayApply(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, candidates: List<File.Entry>) -> Int! {
    opened = GatewayOpened(context.process, folder)
    deleted = Flow.fold(candidates, 0, opened, GatewayRemove)
    printed = Print(String.concat("Deleted ", Int.to_string(deleted), " old Gateway logs"))
    return 0
}
flow GatewayListed(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, days: Int, entries: List<File.Entry>, previous: Int, selected: Int) -> Int! {
    cutoff = Cutoff(days)
    mask = Glob.new("deployment-*.log")
    candidates = List.filter(entries, cutoff, mask, GatewayCandidate)
    printed = Print(String.concat("Gateway: ", Int.to_string(List.length(candidates)), " logs older than ", Int.to_string(days), " days; ", Int.to_string(Math.sum(List.map(candidates, EntryBytes))), " bytes; directory ", PathText(folder)))
    selector_1 = All(List.new(context.apply, Math.gt(List.length(candidates), 0)))
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(GatewayListedChoice_1ChoiceTest1, GatewayListedChoice_1ChoiceResult1)),
        default: GatewayListedChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, candidates, context, folder, GatewayPresentChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, GatewayPresentChoice1Branch2)
    flow GatewayListedChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow GatewayListedChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow GatewayListedChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow AbsentListing(error: Error) -> Record{present: Bool, entries: List<File.Entry>!} {
    flow AbsentListingChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.DirectoryAbsent")
    }

    flow AbsentListingChoiceResult1(request: Record{error: Error, selector: String}) -> List<File.Entry>! {
        return List.new()
    }

    flow AbsentListingChoiceDefault(request: Record{error: Error, selector: String}) -> List<File.Entry>! {
        return request.error
    }

    return Record.new(present: false, entries: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(AbsentListingChoiceTest1, AbsentListingChoiceResult1)),
        default: AbsentListingChoiceDefault
    )))
}
flow OptionalListing(folder: File.Path) -> Record{present: Bool, entries: List<File.Entry>!} onError AbsentListing {
    entries = File.list(folder)
    return Record.new(present: true, entries: entries)
}
flow GatewaySkipAbsent(previous: Int, selected: Int) -> Int! { return GatewayAbsent() }
flow GatewayPresent(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, days: Int) -> Int! {
    observation = OptionalListing(folder)
    entries = observation.entries
    choice = observation.present |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(GatewayPresentChoiceChoiceTest1, GatewayPresentChoiceChoiceResult1)),
        default: GatewayPresentChoiceChoiceDefault
    ))
    listed = Flow.fold(List.filter(List.new(choice), 1, SelectedChoice), 0, context, folder, days, entries, GatewayListed)
    flow GatewayPresentChoiceChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow GatewayPresentChoiceChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow GatewayPresentChoiceChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return Flow.fold(List.filter(List.new(choice), 2, SelectedChoice), listed, GatewaySkipAbsent)
}
flow GatewayLogs(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, days: Int) -> Int! {
    folder = File.Path.join(context.home, "Library/Caches/mprlab-gateway/deployments")
    return GatewayPresent(context, folder, days)
}

flow GatewayAbsent() -> Int! { printed = Print("SKIP Gateway logs: directory absent"); return 0 }
flow CacheTargets(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}) -> List<File.Path>! {
    return Flow.fold(List.new("Library/Caches/staticcheck", "Library/Caches/gopls", "Library/Caches/goimports", "Library/Caches/Homebrew/downloads", ".cache/gh"), List.new(), context.home, ReportPathStep)
}
flow TemporaryPath(text: String, prefix: String) -> File.Path! {
    canonical = Record.new(selector: String.starts_with(text, "/var/folders/"), text: text) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(TemporaryPathCanonicalChoiceTest1, TemporaryPathCanonicalChoiceResult1)),
        default: TemporaryPathCanonicalChoiceDefault
    ))
    path = File.Path.new(canonical)
    normalized = PathText(path)
    checked = Require(All(List.new(Math.eq(List.length(String.lines(text)), 1), String.starts_with(normalized, prefix), String.eq(File.Path.name(path), "T"))), "Cannot validate macOS per-user temporary directory")
    flow TemporaryPathCanonicalChoiceTest1(request: Record{selector: Bool, text: String}) -> Bool {
        return request.selector
    }

    flow TemporaryPathCanonicalChoiceResult1(request: Record{selector: Bool, text: String}) -> String {
        return String.concat("/private", request.text)
    }

    flow TemporaryPathCanonicalChoiceDefault(request: Record{selector: Bool, text: String}) -> String {
        return request.text
    }

    return path
}
flow TempRoots(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, shared: File.Path, prefix: String, getconf: File.Path) -> List<File.Path>! {
    executable = Process.Executable.new(getconf)
    result = RequireSuccess(Run(context.process, executable, List.new("DARWIN_USER_TEMP_DIR"), "capture", 1800))
    checked = Require(Math.eq(Bytes.length(result.stderr), 0), "Temporary directory discovery wrote to stderr")
    user_temp = TemporaryPath(String.trim(String.FromBytes.new(result.stdout)), prefix)
    directory = File.directory(user_temp)
    owned = Require(Math.eq(directory.owner_uid, context.uid), "Cannot validate macOS per-user temporary directory owner")
    return UniquePaths(List.new(shared, user_temp))
}

flow CacheState(count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>) -> Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>} {
    return Record.new(count: count, eligible_bytes: eligible_bytes, deleted: deleted, deleted_bytes: deleted_bytes, skipped: skipped, errors: errors)
}
flow CacheErrors(state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, errors: List<Error>) -> Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>} {
    return CacheState(state.count, state.eligible_bytes, state.deleted, state.deleted_bytes, state.skipped, errors)
}
flow CacheCandidate(uid: Int, device: Int, cutoff: Int, entry: File.Entry) -> Bool {
    return All(List.new(String.eq(entry.kind, "regular"), Math.eq(entry.owner_uid, uid), Math.eq(entry.link_count, 1), Math.eq(entry.device, device), OldFile(cutoff, entry)))
}
flow CacheChild(uid: Int, device: Int, entry: File.Entry) -> Bool {
    return All(List.new(String.eq(entry.kind, "directory"), Math.eq(entry.owner_uid, uid), Math.eq(entry.device, device)))
}
flow CacheGuard(uid: Int, device: Int, cutoff: Int, original: File.Entry, current: File.Entry) -> Bool {
    return All(List.new(SameFile(original, current), CacheCandidate(uid, device, cutoff, current)))
}
flow RequireCacheDirectory(condition: Bool, directory: File.Directory) -> Bool! {
    flow RequireCacheDirectoryChoiceTest1(request: Record{directory: File.Directory, selector: Bool}) -> Bool {
        return request.selector
    }

    flow RequireCacheDirectoryChoiceResult1(request: Record{directory: File.Directory, selector: Bool}) -> Bool! {
        return true
    }

    flow RequireCacheDirectoryChoiceDefault(request: Record{directory: File.Directory, selector: Bool}) -> Bool! {
        return Error.new("Cleanup.CacheDirectory", String.concat("Cache directory owner/device changed: ", File.Path.to_string(request.directory.path)), Record.new())
    }

    return Record.new(selector: condition, directory: directory) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RequireCacheDirectoryChoiceTest1, RequireCacheDirectoryChoiceResult1)),
        default: RequireCacheDirectoryChoiceDefault
    ))
}
flow RequireCacheOwner(directory: File.Directory, uid: Int) -> Bool! {
    flow RequireCacheOwnerChoiceTest1(request: Record{directory: File.Directory, selector: Bool}) -> Bool {
        return request.selector
    }

    flow RequireCacheOwnerChoiceResult1(request: Record{directory: File.Directory, selector: Bool}) -> Bool! {
        return true
    }

    flow RequireCacheOwnerChoiceDefault(request: Record{directory: File.Directory, selector: Bool}) -> Bool! {
        return Error.new("Cleanup.CacheOwner", String.concat("Refusing cache owned by another user: ", File.Path.to_string(request.directory.path)), Record.new())
    }

    return Record.new(selector: Math.eq(directory.owner_uid, uid), directory: directory) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RequireCacheOwnerChoiceTest1, RequireCacheOwnerChoiceResult1)),
        default: RequireCacheOwnerChoiceDefault
    ))
}
flow CacheObserve(uid: Int, device: Int, directory: File.Directory) -> File.Scan! {
    scan = File.Directory.scan(directory)
    current = scan.directory
    valid = All(List.new(SameDirectory(directory, current), Math.eq(current.owner_uid, uid), Math.eq(current.device, device)))
    checked = RequireCacheDirectory(valid, directory)
    return scan
}
flow CacheProbe(context: Process.Context, directory: File.Directory, paths: List<File.Path>) -> List<File.Path>! {
    opened = OpenedPaths(context, paths)
    current = File.Directory.refresh(directory)
    checked = RequireCacheDirectory(All(List.new(SameDirectory(directory, current), Math.eq(directory.owner_uid, current.owner_uid))), directory)
    return opened
}
flow CacheCommit(uid: Int, device: Int, cutoff: Int, entry: File.Entry) -> Record{removed: Bool!} onError FileChanged {
    target = File.Remove.checked(List.new(entry), uid, device, cutoff, CacheGuard)
    commit target
    return Record.new(removed: true)
}
flow CacheRemove(uid: Int, device: Int, cutoff: Int, entry: File.Entry) -> Bool! {
    result = CacheCommit(uid, device, cutoff, entry)
    return result.removed
}
flow CacheRemoveStep(uid: Int, device: Int, cutoff: Int, opened: List<File.Path>, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, entry: File.Entry) -> Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}! {
    selector_1 = Math.eq(List.length(state.errors), 0)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheRemoveStepChoice_1ChoiceTest1, CacheRemoveStepChoice_1ChoiceResult1)),
        default: CacheRemoveStepChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), state, cutoff, device, entry, opened, state, uid, CacheRemoveStepChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, state, CacheRemoveStepChoice1Branch2)
    flow CacheRemoveStepChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow CacheRemoveStepChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow CacheRemoveStepChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow CacheRemoveActive(uid: Int, device: Int, cutoff: Int, opened: List<File.Path>, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, entry: File.Entry) -> Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}! {
    selector_1 = PathMember(opened, entry.path)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheRemoveActiveChoice_1ChoiceTest1, CacheRemoveActiveChoice_1ChoiceResult1)),
        default: CacheRemoveActiveChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), state, state, CacheRemoveActiveChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, cutoff, device, entry, state, uid, CacheRemoveActiveChoice1Branch2)
    flow CacheRemoveActiveChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow CacheRemoveActiveChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow CacheRemoveActiveChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow CacheRemoveClosed(uid: Int, device: Int, cutoff: Int, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, entry: File.Entry) -> Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}! {
    attempt = TryCacheRemove(uid, device, cutoff, entry)
    flow CacheRemoveClosedChoiceTest1(request: Record{attempt: Record{errors: List<Error>, result: Bool!}, entry: File.Entry, selector: Int, state: Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow CacheRemoveClosedChoiceResult1(request: Record{attempt: Record{errors: List<Error>, result: Bool!}, entry: File.Entry, selector: Int, state: Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}}) -> Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}! {
        return CacheRemoved(request.state, request.entry, request.attempt.result)
    }

    flow CacheRemoveClosedChoiceDefault(request: Record{attempt: Record{errors: List<Error>, result: Bool!}, entry: File.Entry, selector: Int, state: Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}}) -> Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}! {
        return CacheErrors(request.state, request.attempt.errors)
    }

    return Record.new(selector: List.length(attempt.errors), attempt: attempt, entry: entry, state: state) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheRemoveClosedChoiceTest1, CacheRemoveClosedChoiceResult1)),
        default: CacheRemoveClosedChoiceDefault
    ))
}
flow CacheRemoved(state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, entry: File.Entry, removed: Bool) -> Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>} {
    flow CacheRemovedChoiceTest1(request: Record{entry: File.Entry, selector: Bool, state: Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}}) -> Bool {
        return request.selector
    }

    flow CacheRemovedChoiceResult1(request: Record{entry: File.Entry, selector: Bool, state: Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}}) -> Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int} {
        return CacheState(request.state.count, request.state.eligible_bytes, Math.add(request.state.deleted, 1), Math.add(request.state.deleted_bytes, request.entry.allocated_bytes), request.state.skipped, request.state.errors)
    }

    flow CacheRemovedChoiceDefault(request: Record{entry: File.Entry, selector: Bool, state: Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}}) -> Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int} {
        return CacheState(request.state.count, request.state.eligible_bytes, request.state.deleted, request.state.deleted_bytes, Math.add(request.state.skipped, 1), request.state.errors)
    }

    return Record.new(selector: removed, entry: entry, state: state) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheRemovedChoiceTest1, CacheRemovedChoiceResult1)),
        default: CacheRemovedChoiceDefault
    ))
}
flow AbsentDirectory(error: Error) -> Record{directories: List<File.Directory>!} {
    flow AbsentDirectoryChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.DirectoryAbsent")
    }

    flow AbsentDirectoryChoiceResult1(request: Record{error: Error, selector: String}) -> List<File.Directory>! {
        return List.new()
    }

    flow AbsentDirectoryChoiceDefault(request: Record{error: Error, selector: String}) -> List<File.Directory>! {
        return request.error
    }

    return Record.new(directories: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(AbsentDirectoryChoiceTest1, AbsentDirectoryChoiceResult1)),
        default: AbsentDirectoryChoiceDefault
    )))
}
flow OptionalChild(directory: File.Directory, entry: File.Entry) -> Record{directories: List<File.Directory>!} onError AbsentDirectory {
    child = File.Directory.child(directory, entry)
    return Record.new(directories: List.new(child))
}
flow CacheChildDirectories(directory: File.Directory, entry: File.Entry) -> List<File.Directory>! {
    result = OptionalChild(directory, entry)
    return result.directories
}
flow CacheProbeAndRemove(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, device: Int, cutoff: Int, directory: File.Directory, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, candidates: List<File.Entry>) -> Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}! {
    attempt = TryCacheProbe(context.process, directory, List.map(candidates, EntryPath))
    selector_1 = List.length(attempt.errors)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheProbeAndRemoveChoice_1ChoiceTest1, CacheProbeAndRemoveChoice_1ChoiceResult1)),
        default: CacheProbeAndRemoveChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), state, attempt, candidates, context, cutoff, device, state, CacheProbeAndRemoveChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, attempt, state, CacheProbeAndRemoveChoice1Branch2)
    flow CacheProbeAndRemoveChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow CacheProbeAndRemoveChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow CacheProbeAndRemoveChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow CacheSummary(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}) -> Int! {
    printed = Print(String.concat(File.Path.to_string(folder), ": ", Int.to_string(state.count), " stale files / ", Int.to_string(state.eligible_bytes), " allocated bytes; deleted ", Int.to_string(state.deleted), " / ", Int.to_string(state.deleted_bytes), " allocated bytes; skipped ", Int.to_string(state.skipped)))
    selector_1 = context.apply
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheSummaryChoice_1ChoiceTest1, CacheSummaryChoice_1ChoiceResult1)),
        default: CacheSummaryChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), false, CacheSummaryChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, CacheSummaryChoice1Branch2)
    preview = choice_1_result_2
    flow CacheSummaryChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow CacheSummaryChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow CacheSummaryChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    flow CacheSummaryChoiceTest1(request: Record{selector: Int, state: Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow CacheSummaryChoiceResult1(request: Record{selector: Int, state: Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}}) -> Int! {
        return request.state.eligible_bytes
    }

    flow CacheSummaryChoiceDefault(request: Record{selector: Int, state: Record{count: Int, deleted: Int, deleted_bytes: Int, eligible_bytes: Int, errors: List<Error>, skipped: Int}}) -> Int! {
        return CacheFailure(List.at(request.state.errors, 0))
    }

    return Record.new(selector: List.length(state.errors), state: state) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheSummaryChoiceTest1, CacheSummaryChoiceResult1)),
        default: CacheSummaryChoiceDefault
    ))
}
flow CacheFailure(error: Error) -> Int! { return error }
flow StaleCachePresent(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, days: Int, previous: Int, directory: File.Directory) -> Int! {
    checked = RequireCacheOwner(directory, context.uid)
    cutoff = Cutoff(days)
    initial = CacheState(0, 0, 0, 0, 0, List.new())
    result = CacheWalk(context, directory.device, cutoff, directory, initial)
    return CacheSummary(context, folder, result)
}
flow StaleCache(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, days: Int) -> Int! {
    observation = OptionalDirectory(folder)
    directories = observation.directories
    absent = Flow.fold(List.filter(List.new(List.length(directories)), 0, SelectedChoice), 0, folder, StaleCacheChoice1Branch1)
    return Flow.fold(directories, absent, context, folder, days, StaleCachePresent)
}
flow OptionalDirectory(folder: File.Path) -> Record{directories: List<File.Directory>!} onError AbsentDirectory {
    directory = File.directory(folder)
    return Record.new(directories: List.new(directory))
}
flow SkipAbsentCache(folder: File.Path) -> Int! { printed = Print(String.concat("SKIP absent cache: ", File.Path.to_string(folder))); return 0 }
flow TreeDescend(uid: Int, device: Int, entry: File.Entry) -> Bool {
    return All(List.new(String.eq(entry.kind, "directory"), Math.eq(entry.owner_uid, uid), Math.eq(entry.device, device)))
}
flow TreeSupported(uid: Int, device: Int, cutoff: Int, row: Record{relative: String, entry: File.Entry}) -> Bool {
    entry = row.entry
    supported = StringMember(List.new("directory", "regular", "symlink"), entry.kind)
    links = Record.new(selector: entry.kind, entry: entry) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(TreeSupportedLinksChoiceTest1, TreeSupportedLinksChoiceResult1)),
        default: TreeSupportedLinksChoiceDefault
    ))
    old = Record.new(selector: entry.kind, cutoff: cutoff, entry: entry) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(TreeSupportedOldChoiceTest1, TreeSupportedOldChoiceResult1)),
        default: TreeSupportedOldChoiceDefault
    ))
    flow TreeSupportedLinksChoiceTest1(request: Record{entry: File.Entry, selector: String}) -> Bool {
        return String.eq(request.selector, "directory")
    }

    flow TreeSupportedLinksChoiceResult1(request: Record{entry: File.Entry, selector: String}) -> Bool {
        return true
    }

    flow TreeSupportedLinksChoiceDefault(request: Record{entry: File.Entry, selector: String}) -> Bool {
        return Math.eq(request.entry.link_count, 1)
    }

    flow TreeSupportedOldChoiceTest1(request: Record{cutoff: Int, entry: File.Entry, selector: String}) -> Bool {
        return String.eq(request.selector, "directory")
    }

    flow TreeSupportedOldChoiceResult1(request: Record{cutoff: Int, entry: File.Entry, selector: String}) -> Bool {
        return All(List.new(Math.lt(request.entry.modified_unix_ns, request.cutoff), Math.lt(request.entry.changed_unix_ns, request.cutoff)))
    }

    flow TreeSupportedOldChoiceDefault(request: Record{cutoff: Int, entry: File.Entry, selector: String}) -> Bool {
        return OldFile(request.cutoff, request.entry)
    }

    return All(List.new(supported, Math.eq(entry.owner_uid, uid), Math.eq(entry.device, device), links, old))
}
flow TreeAllocation(row: Record{relative: String, entry: File.Entry}) -> Int { return row.entry.allocated_bytes }
flow SameTreeRow(before: Record{relative: String, entry: File.Entry}, after: Record{relative: String, entry: File.Entry}) -> Bool {
    original = before.entry
    current = after.entry
    accessed = Record.new(selector: original.kind, current: current, original: original) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(SameTreeRowAccessedChoiceTest1, SameTreeRowAccessedChoiceResult1)),
        default: SameTreeRowAccessedChoiceDefault
    ))
    flow SameTreeRowAccessedChoiceTest1(request: Record{current: File.Entry, original: File.Entry, selector: String}) -> Bool {
        return String.eq(request.selector, "directory")
    }

    flow SameTreeRowAccessedChoiceResult1(request: Record{current: File.Entry, original: File.Entry, selector: String}) -> Bool {
        return true
    }

    flow SameTreeRowAccessedChoiceDefault(request: Record{current: File.Entry, original: File.Entry, selector: String}) -> Bool {
        return Math.eq(request.original.accessed_unix_ns, request.current.accessed_unix_ns)
    }

    return All(List.new(String.eq(before.relative, after.relative), Math.eq(original.device, current.device), Math.eq(original.inode, current.inode), String.eq(original.kind, current.kind), Math.eq(original.owner_uid, current.owner_uid), Math.eq(original.link_count, current.link_count), Math.eq(original.size_bytes, current.size_bytes), Math.eq(original.allocated_bytes, current.allocated_bytes), Math.eq(original.modified_unix_ns, current.modified_unix_ns), Math.eq(original.changed_unix_ns, current.changed_unix_ns), accessed))
}
flow SameTree(before: File.Tree, after: File.Tree) -> Bool! {
    return All(List.new(before.complete, after.complete, Math.eq(List.length(before.entries), List.length(after.entries)), TreeRowsEqual(before.entries, after.entries)))
}
flow BuildParent(uid: Int, parent: File.Directory) -> File.Directory! {
    current = File.Directory.refresh(parent)
    flow BuildParentChoiceTest1(request: Record{current: File.Directory, parent: File.Directory, selector: Bool}) -> Bool {
        return request.selector
    }

    flow BuildParentChoiceResult1(request: Record{current: File.Directory, parent: File.Directory, selector: Bool}) -> File.Directory! {
        return request.current
    }

    flow BuildParentChoiceDefault(request: Record{current: File.Directory, parent: File.Directory, selector: Bool}) -> File.Directory! {
        return Error.new("Cleanup.BuildParent", String.concat("Build parent changed: ", File.Path.to_string(request.parent.path)), Record.new())
    }

    return Record.new(selector: All(List.new(SameDirectory(parent, current), Math.eq(current.owner_uid, uid))), current: current, parent: parent) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuildParentChoiceTest1, BuildParentChoiceResult1)),
        default: BuildParentChoiceDefault
    ))
}
flow BuildParentChanged(error: Error) -> Record{valid: Bool!} {
    flow BuildParentChangedChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.DirectoryChanged")
    }

    flow BuildParentChangedChoiceResult1(request: Record{error: Error, selector: String}) -> Bool! {
        return false
    }

    flow BuildParentChangedChoiceTest2(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.DirectoryAbsent")
    }

    flow BuildParentChangedChoiceTest3(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "Cleanup.BuildParent")
    }

    flow BuildParentChangedChoiceDefault(request: Record{error: Error, selector: String}) -> Bool! {
        return request.error
    }

    return Record.new(valid: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(
            Match.Case.new(BuildParentChangedChoiceTest1, BuildParentChangedChoiceResult1),
            Match.Case.new(BuildParentChangedChoiceTest2, BuildParentChangedChoiceResult1),
            Match.Case.new(BuildParentChangedChoiceTest3, BuildParentChangedChoiceResult1),
        ),
        default: BuildParentChangedChoiceDefault
    )))
}
flow TryBuildParent(uid: Int, parent: File.Directory) -> Record{valid: Bool!} onError BuildParentChanged {
    checked = BuildParent(uid, parent)
    return Record.new(valid: true)
}
flow BuildOpen(context: Process.Context, folder: File.Path) -> Bool! {
    result = Run(context, Lsof(context), List.new("-F0n", "+D", File.Path.to_string(folder)), "capture", 30)
    accepted = LsofStatus(result)
    checked = RequireOpenFiles(Math.eq(Bytes.length(result.stderr), 0), String.concat("Cannot verify open build tree: ", File.Path.to_string(folder)))
    return Math.gt(Bytes.length(result.stdout), 0)
}
flow BuildSkipOpen(folder: File.Path) -> Int! { printed = Print(String.concat("SKIP open build tree: ", File.Path.to_string(folder))); return 0 }
flow BuildSkipChanged(folder: File.Path) -> Int! { printed = Print(String.concat("SKIP changed build tree: ", File.Path.to_string(folder))); return 0 }
flow BuildSnapshotChanged(error: Error) -> Record{trees: List<File.Tree>!} {
    flow BuildSnapshotChangedChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.DirectoryChanged")
    }

    flow BuildSnapshotChangedChoiceResult1(request: Record{error: Error, selector: String}) -> List<File.Tree>! {
        return List.new()
    }

    flow BuildSnapshotChangedChoiceTest2(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.DirectoryAbsent")
    }

    flow BuildSnapshotChangedChoiceDefault(request: Record{error: Error, selector: String}) -> List<File.Tree>! {
        return request.error
    }

    return Record.new(trees: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(
            Match.Case.new(BuildSnapshotChangedChoiceTest1, BuildSnapshotChangedChoiceResult1),
            Match.Case.new(BuildSnapshotChangedChoiceTest2, BuildSnapshotChangedChoiceResult1),
        ),
        default: BuildSnapshotChangedChoiceDefault
    )))
}
flow TryBuildSnapshot(uid: Int, device: Int, parent: File.Directory, root: File.Entry) -> Record{trees: List<File.Tree>!} onError BuildSnapshotChanged {
    tree = File.Tree.snapshot(parent, root, uid, device, TreeDescend)
    return Record.new(trees: List.new(tree))
}
flow BuildRemove(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, parent: File.Directory, root: File.Entry, cutoff: Int, before: File.Tree, size: Int) -> Int! {
    observed = TryBuildSnapshot(context.uid, parent.device, parent, root)
    trees = observed.trees
    skipped = Flow.fold(List.filter(List.new(0), Math.eq(List.length(trees), 0), SelectedWhen), 0, folder, BuildRemoveChoice1Branch2)
    return Flow.fold(trees, skipped, context, folder, parent, cutoff, before, size, BuildReobserved)
}
flow BuildReobserved(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, parent: File.Directory, cutoff: Int, before: File.Tree, size: Int, previous: Int, after: File.Tree) -> Int! {
    parent_result = TryBuildParent(context.uid, parent)
    parent_valid = parent_result.valid
    eligible = All(List.map(after.entries, context.uid, parent.device, cutoff, TreeSupported))
    unchanged = All(List.new(parent_valid, eligible, SameTree(before, after)))
    choice = unchanged |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuildReobservedChoiceChoiceTest1, BuildReobservedChoiceChoiceResult1)),
        default: BuildReobservedChoiceChoiceDefault
    ))
    removed = Flow.fold(List.filter(List.new(choice), 1, SelectedChoice), 0, context.uid, parent.device, cutoff, folder, before, size, BuildRemoveChoice1Branch1)
    flow BuildReobservedChoiceChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow BuildReobservedChoiceChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow BuildReobservedChoiceChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return Flow.fold(List.filter(List.new(choice), 2, SelectedChoice), removed, folder, BuildRemoveChoice1Branch2)
}
flow SelectedWhen(selected: Bool, value: Int) -> Bool { return selected }

flow BuildCommit(uid: Int, device: Int, cutoff: Int, folder: File.Path, before: File.Tree, size: Int) -> Int! {
    target = File.Tree.Remove.checked(before, uid, device, cutoff, TreeSupported)
    commit target
    printed = Print(String.concat("Deleted whole build tree: ", File.Path.to_string(folder), "; ", Int.to_string(size), " bytes observed allocation"))
    return size
}

flow BuildProbe(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, parent: File.Directory, root: File.Entry, cutoff: Int, before: File.Tree, size: Int) -> Int! {
    selector_1 = BuildOpen(context.process, folder)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuildProbeChoice_1ChoiceTest1, BuildProbeChoice_1ChoiceResult1)),
        default: BuildProbeChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, folder, BuildProbeChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, before, context, cutoff, folder, parent, root, size, BuildProbeChoice1Branch2)
    flow BuildProbeChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow BuildProbeChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow BuildProbeChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow BuildEligible(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, folder: File.Path, parent: File.Directory, root: File.Entry, cutoff: Int, before: File.Tree, size: Int) -> Int! {
    printed = Print(String.concat(context.apply |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuildEligiblePrintedChoiceTest1, BuildEligiblePrintedChoiceResult1)),
        default: BuildEligiblePrintedChoiceDefault
    )), " whole stale build tree: ", File.Path.to_string(folder), "; ", Int.to_string(size), " bytes allocated"))
    selector_1 = context.apply
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuildEligibleChoice_1ChoiceTest1, BuildEligibleChoice_1ChoiceResult1)),
        default: BuildEligibleChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, before, context, cutoff, folder, parent, root, size, BuildEligibleChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, size, BuildEligibleChoice1Branch2)
    flow BuildEligiblePrintedChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow BuildEligiblePrintedChoiceResult1(value: Bool) -> String {
        return "RUN"
    }

    flow BuildEligiblePrintedChoiceDefault(value: Bool) -> String {
        return "PLAN"
    }

    flow BuildEligibleChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow BuildEligibleChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow BuildEligibleChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow BuildSkipRecent(folder: File.Path) -> Int! { printed = Print(String.concat("SKIP active/recent/unsupported build tree: ", File.Path.to_string(folder))); return 0 }
flow StaleBuildTree(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, parent: File.Directory, root: File.Entry, days: Int) -> Int! {
    folder = root.path
    cutoff = Cutoff(days)
    current_parent = BuildParent(context.uid, parent)
    before = File.Tree.snapshot(current_parent, root, context.uid, parent.device, TreeDescend)
    eligible = All(List.new(before.complete, All(List.map(before.entries, context.uid, parent.device, cutoff, TreeSupported))))
    size = Math.sum(List.map(before.entries, TreeAllocation))
    choice = eligible |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StaleBuildTreeChoiceChoiceTest1, StaleBuildTreeChoiceChoiceResult1)),
        default: StaleBuildTreeChoiceChoiceDefault
    ))
    eligible_result = Flow.fold(List.filter(List.new(choice), 1, SelectedChoice), 0, before, context, cutoff, folder, current_parent, root, size, StaleBuildTreeChoice1Branch1)
    flow StaleBuildTreeChoiceChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow StaleBuildTreeChoiceChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow StaleBuildTreeChoiceChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return Flow.fold(List.filter(List.new(choice), 2, SelectedChoice), eligible_result, folder, StaleBuildTreeChoice1Branch2)
}
flow TreeTargetGroup(values: List<Record{parent: File.Directory, root: File.Entry}>) -> List<Record{parent: File.Directory, root: File.Entry}> { return values }
flow ConcatTreeTargets(left: List<Record{parent: File.Directory, root: File.Entry}>, right: List<Record{parent: File.Directory, root: File.Entry}>) -> List<Record{parent: File.Directory, root: File.Entry}> { return List.flat_map(List.new(left, right), TreeTargetGroup) }
flow XcodeTarget(uid: Int, parent: File.Directory, entry: File.Entry) -> List<Record{parent: File.Directory, root: File.Entry}>! {
    valid = All(List.new(String.eq(entry.kind, "directory"), Math.eq(entry.owner_uid, uid), Math.eq(entry.device, parent.device)))
    flow XcodeTargetChoiceTest1(request: Record{entry: File.Entry, parent: File.Directory, selector: Bool, uid: Int}) -> Bool {
        return request.selector
    }

    flow XcodeTargetChoiceResult1(request: Record{entry: File.Entry, parent: File.Directory, selector: Bool, uid: Int}) -> List<Record{parent: File.Directory, root: File.Entry}>! {
        return XcodeDirectoryTarget(request.uid, request.parent, request.entry)
    }

    flow XcodeTargetChoiceDefault(request: Record{entry: File.Entry, parent: File.Directory, selector: Bool, uid: Int}) -> List<Record{parent: File.Directory, root: File.Entry}>! {
        return List.new()
    }

    return Record.new(selector: valid, entry: entry, parent: parent, uid: uid) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(XcodeTargetChoiceTest1, XcodeTargetChoiceResult1)),
        default: XcodeTargetChoiceDefault
    ))
}
flow XcodeDirectoryTarget(uid: Int, parent: File.Directory, entry: File.Entry) -> List<Record{parent: File.Directory, root: File.Entry}>! {
    shared = List.new("ModuleCache.noindex", "SDKStatCaches.noindex", "SDKExplicitPrecompiledModules", "CompilationCache.noindex")
    flow XcodeDirectoryTargetChoiceTest1(request: Record{entry: File.Entry, parent: File.Directory, selector: Bool, uid: Int}) -> Bool {
        return request.selector
    }

    flow XcodeDirectoryTargetChoiceResult1(request: Record{entry: File.Entry, parent: File.Directory, selector: Bool, uid: Int}) -> List<Record{parent: File.Directory, root: File.Entry}>! {
        return List.new(Record.new(parent: request.parent, root: request.entry))
    }

    flow XcodeDirectoryTargetChoiceDefault(request: Record{entry: File.Entry, parent: File.Directory, selector: Bool, uid: Int}) -> List<Record{parent: File.Directory, root: File.Entry}>! {
        return XcodeProjectTarget(request.uid, request.parent, request.entry)
    }

    return Record.new(selector: StringMember(shared, entry.name), entry: entry, parent: parent, uid: uid) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(XcodeDirectoryTargetChoiceTest1, XcodeDirectoryTargetChoiceResult1)),
        default: XcodeDirectoryTargetChoiceDefault
    ))
}
flow AbsentBuildEntry(error: Error) -> Record{entries: List<File.Entry>!} {
    flow AbsentBuildEntryChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "File.EntryAbsent")
    }

    flow AbsentBuildEntryChoiceResult1(request: Record{error: Error, selector: String}) -> List<File.Entry>! {
        return List.new()
    }

    flow AbsentBuildEntryChoiceDefault(request: Record{error: Error, selector: String}) -> List<File.Entry>! {
        return request.error
    }

    return Record.new(entries: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(AbsentBuildEntryChoiceTest1, AbsentBuildEntryChoiceResult1)),
        default: AbsentBuildEntryChoiceDefault
    )))
}
flow OptionalBuildEntry(parent: File.Directory) -> Record{entries: List<File.Entry>!} onError AbsentBuildEntry {
    entry = File.Directory.entry(parent, "Build")
    return Record.new(entries: List.new(entry))
}
flow XcodeBuildTarget(parent: File.Directory, targets: List<Record{parent: File.Directory, root: File.Entry}>, entry: File.Entry) -> List<Record{parent: File.Directory, root: File.Entry}> {
    flow XcodeBuildTargetChoiceTest1(request: Record{entry: File.Entry, parent: File.Directory, selector: Bool, targets: List<Record{parent: File.Directory, root: File.Entry}>}) -> Bool {
        return request.selector
    }

    flow XcodeBuildTargetChoiceResult1(request: Record{entry: File.Entry, parent: File.Directory, selector: Bool, targets: List<Record{parent: File.Directory, root: File.Entry}>}) -> List<Record{parent: File.Directory, root: File.Entry}> {
        return ConcatTreeTargets(request.targets, List.new(Record.new(parent: request.parent, root: request.entry)))
    }

    flow XcodeBuildTargetChoiceDefault(request: Record{entry: File.Entry, parent: File.Directory, selector: Bool, targets: List<Record{parent: File.Directory, root: File.Entry}>}) -> List<Record{parent: File.Directory, root: File.Entry}> {
        return request.targets
    }

    return Record.new(selector: String.eq(entry.kind, "directory"), entry: entry, parent: parent, targets: targets) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(XcodeBuildTargetChoiceTest1, XcodeBuildTargetChoiceResult1)),
        default: XcodeBuildTargetChoiceDefault
    ))
}
flow RequireXcodeDirectory(condition: Bool, directory: File.Directory) -> Bool! {
    flow RequireXcodeDirectoryChoiceTest1(request: Record{directory: File.Directory, selector: Bool}) -> Bool {
        return request.selector
    }

    flow RequireXcodeDirectoryChoiceResult1(request: Record{directory: File.Directory, selector: Bool}) -> Bool! {
        return true
    }

    flow RequireXcodeDirectoryChoiceDefault(request: Record{directory: File.Directory, selector: Bool}) -> Bool! {
        return Error.new("Cleanup.DerivedData", String.concat("Refusing changed or foreign-owned Xcode directory: ", File.Path.to_string(request.directory.path)), Record.new())
    }

    return Record.new(selector: condition, directory: directory) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RequireXcodeDirectoryChoiceTest1, RequireXcodeDirectoryChoiceResult1)),
        default: RequireXcodeDirectoryChoiceDefault
    ))
}
flow XcodeProjectPresent(uid: Int, entry: File.Entry, targets: List<Record{parent: File.Directory, root: File.Entry}>, directory: File.Directory) -> List<Record{parent: File.Directory, root: File.Entry}>! {
    valid = All(List.new(Math.eq(directory.owner_uid, uid), Math.eq(directory.device, entry.device), Math.eq(directory.inode, entry.inode)))
    checked = RequireXcodeDirectory(valid, directory)
    observed = OptionalBuildEntry(directory)
    return List.fold(observed.entries, targets, directory, XcodeBuildTarget)
}
flow XcodeProjectTarget(uid: Int, parent: File.Directory, entry: File.Entry) -> List<Record{parent: File.Directory, root: File.Entry}>! {
    opened = OptionalChild(parent, entry)
    return Flow.fold(opened.directories, List.new(), uid, entry, XcodeProjectPresent)
}
flow XcodeTargetStep(uid: Int, parent: File.Directory, targets: List<Record{parent: File.Directory, root: File.Entry}>, entry: File.Entry) -> List<Record{parent: File.Directory, root: File.Entry}>! {
    return ConcatTreeTargets(targets, XcodeTarget(uid, parent, entry))
}
flow XcodeVanished(root: File.Path, previous: Bool, name: String) -> Bool! {
    return Print(String.concat("SKIP vanished Xcode entry: ", File.Path.to_string(File.Path.join(root, name))))
}
flow XcodePresent(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, targets: List<Record{parent: File.Directory, root: File.Entry}>, directory: File.Directory) -> List<Record{parent: File.Directory, root: File.Entry}>! {
    owned = RequireXcodeDirectory(Math.eq(directory.owner_uid, context.uid), directory)
    scan = File.Directory.scan(directory)
    current = scan.directory
    checked = RequireXcodeDirectory(All(List.new(SameDirectory(directory, current), Math.eq(current.owner_uid, context.uid))), current)
    skipped = Flow.fold(scan.vanished_names, true, current.path, XcodeVanished)
    return Flow.fold(scan.entries, targets, context.uid, current, XcodeTargetStep)
}
flow XcodeTargets(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}) -> List<Record{parent: File.Directory, root: File.Entry}>! {
    root = File.Path.join(context.home, "Library/Developer/Xcode/DerivedData")
    opened = OptionalDirectory(root)
    return Flow.fold(opened.directories, List.new(), context, XcodePresent)
}
flow TryStaleBuildTree(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, target: Record{parent: File.Directory, root: File.Entry}) -> Record{result: Int!, errors: List<Error>} onError CapturedPerformError {
    result = StaleBuildTree(context, target.parent, target.root, 7)
    return Record.new(result: result, errors: List.new())
}
flow AttemptTree(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, state: Record{failures: List<String>, estimates: List<Int>}, target: Record{parent: File.Directory, root: File.Entry}) -> Record{failures: List<String>, estimates: List<Int>}! {
    captured = TryStaleBuildTree(context, target)
    return RecordOutcome(state, File.Path.to_string(target.root.path), captured)
}

// A bounded worklist visits retained directories in depth-first order.
flow CacheWorkItem(parent: File.Directory, entry: File.Entry) -> Record{parent: File.Directory, entries: List<File.Entry>} {
    return Record.new(parent: parent, entries: List.new(entry))
}
flow CacheWorkResult(state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, items: List<Record{parent: File.Directory, entries: List<File.Entry>}>) -> Record{state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, items: List<Record{parent: File.Directory, entries: List<File.Entry>}>, stop: Bool} {
    return Record.new(state: state, items: items, stop: Math.gt(List.length(state.errors), 0))
}
flow CacheWorkStep(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, device: Int, cutoff: Int, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, item: Record{parent: File.Directory, entries: List<File.Entry>}) -> Record{state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, items: List<Record{parent: File.Directory, entries: List<File.Entry>}>, stop: Bool}! {
    selector_1 = List.length(state.errors)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheWorkStepChoice_1ChoiceTest1, CacheWorkStepChoice_1ChoiceResult1)),
        default: CacheWorkStepChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), CacheWorkResult(state, List.new()), context, cutoff, device, item, state, CacheWorkStepChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, state, CacheWorkStepChoice1Branch2)
    flow CacheWorkStepChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow CacheWorkStepChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow CacheWorkStepChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow CacheWorkActive(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, device: Int, cutoff: Int, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, item: Record{parent: File.Directory, entries: List<File.Entry>}) -> Record{state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, items: List<Record{parent: File.Directory, entries: List<File.Entry>}>, stop: Bool}! {
    selector_1 = List.length(item.entries)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheWorkActiveChoice_1ChoiceTest1, CacheWorkActiveChoice_1ChoiceResult1)),
        default: CacheWorkActiveChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), CacheWorkResult(state, List.new()), context, cutoff, device, item, state, CacheWorkActiveChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, context, cutoff, device, item, state, CacheWorkActiveChoice1Branch2)
    flow CacheWorkActiveChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow CacheWorkActiveChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow CacheWorkActiveChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow CacheWorkChild(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, device: Int, cutoff: Int, parent: File.Directory, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, entry: File.Entry) -> Record{state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, items: List<Record{parent: File.Directory, entries: List<File.Entry>}>, stop: Bool}! {
    attempt = TryCacheChildDirectories(parent, entry)
    selector_1 = List.length(attempt.errors)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheWorkChildChoice_1ChoiceTest1, CacheWorkChildChoice_1ChoiceResult1)),
        default: CacheWorkChildChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), CacheWorkResult(state, List.new()), attempt, context, cutoff, device, state, CacheWorkChildChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, attempt, state, CacheWorkChildChoice1Branch2)
    flow CacheWorkChildChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow CacheWorkChildChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow CacheWorkChildChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow CacheWorkOpened(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, device: Int, cutoff: Int, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, directories: List<File.Directory>) -> Record{state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, items: List<Record{parent: File.Directory, entries: List<File.Entry>}>, stop: Bool}! {
    selector_1 = List.length(directories)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheWorkOpenedChoice_1ChoiceTest1, CacheWorkOpenedChoice_1ChoiceResult1)),
        default: CacheWorkOpenedChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), CacheWorkResult(state, List.new()), state, CacheWorkOpenedChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, context, cutoff, device, directories, state, CacheWorkOpenedChoice1Branch2)
    flow CacheWorkOpenedChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow CacheWorkOpenedChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow CacheWorkOpenedChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow CacheWorkScan(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, device: Int, cutoff: Int, directory: File.Directory, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}) -> Record{state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, items: List<Record{parent: File.Directory, entries: List<File.Entry>}>, stop: Bool}! {
    attempt = TryCacheObserve(context.uid, device, directory)
    selector_1 = List.length(attempt.errors)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheWorkScanChoice_1ChoiceTest1, CacheWorkScanChoice_1ChoiceResult1)),
        default: CacheWorkScanChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), CacheWorkResult(state, List.new()), attempt, context, cutoff, device, directory, state, CacheWorkScanChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, attempt, state, CacheWorkScanChoice1Branch2)
    flow CacheWorkScanChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow CacheWorkScanChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow CacheWorkScanChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}
flow CacheWorkObserved(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, device: Int, cutoff: Int, directory: File.Directory, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, scan: File.Scan) -> Record{state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}, items: List<Record{parent: File.Directory, entries: List<File.Entry>}>, stop: Bool}! {
    eligible = List.filter(scan.entries, context.uid, device, cutoff, CacheCandidate)
    candidates = List.filter(eligible, UnambiguousPath)
    children = List.filter(scan.entries, context.uid, device, CacheChild)
    counted = CacheState(Math.add(state.count, List.length(eligible)), Math.add(state.eligible_bytes, Math.sum(List.map(eligible, EntryAllocation))), state.deleted, state.deleted_bytes, Math.add(state.skipped, Math.sub(List.length(eligible), List.length(candidates))), state.errors)
    selector_1 = All(List.new(context.apply, Math.gt(List.length(candidates), 0)))
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CacheWorkObservedChoice_1ChoiceTest1, CacheWorkObservedChoice_1ChoiceResult1)),
        default: CacheWorkObservedChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), counted, candidates, context, counted, cutoff, device, directory, CacheWorkObservedChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, counted, CacheWorkObservedChoice1Branch2)
    removed = choice_1_result_2
    flow CacheWorkObservedChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow CacheWorkObservedChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow CacheWorkObservedChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return CacheWorkResult(removed, List.map(children, directory, CacheWorkItem))
}
flow CacheWalk(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, device: Int, cutoff: Int, directory: File.Directory, state: Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}) -> Record{count: Int, eligible_bytes: Int, deleted: Int, deleted_bytes: Int, skipped: Int, errors: List<Error>}! {
    initial = CacheRootItem(directory)
    return Flow.worklist(List.new(initial), state, context, device, cutoff, CacheWorkStep)
}

flow CacheRootItem(directory: File.Directory) -> Record{parent: File.Directory, entries: List<File.Entry>} {
    return Record.new(parent: directory, entries: List.new())
}

// Self-handling flows keep recoverable errors in typed result records.
flow CapturedEnvironmentValueError(error: Error) -> Record{result: String!, errors: List<Error>} {
    return Record.new(result: error, errors: List.new(error))
}
flow TryEnvironmentValue(context: Process.Context, name: String) -> Record{result: String!, errors: List<Error>} onError CapturedEnvironmentValueError {
    result = EnvironmentValue(context, name)
    return Record.new(result: result, errors: List.new())
}

flow CapturedPerformError(error: Error) -> Record{result: Int!, errors: List<Error>} {
    return Record.new(result: error, errors: List.new(error))
}
flow TryPerform(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, task: Record{label: String, operation: String, path: File.Path, arguments: List<String>}) -> Record{result: Int!, errors: List<Error>} onError CapturedPerformError {
    result = Perform(context, task)
    return Record.new(result: result, errors: List.new())
}

flow CapturedXcodeTargetsError(error: Error) -> Record{result: List<Record{parent: File.Directory, root: File.Entry}>!, errors: List<Error>} {
    return Record.new(result: error, errors: List.new(error))
}
flow TryXcodeTargets(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}) -> Record{result: List<Record{parent: File.Directory, root: File.Entry}>!, errors: List<Error>} onError CapturedXcodeTargetsError {
    result = XcodeTargets(context)
    return Record.new(result: result, errors: List.new())
}

flow CapturedPreparePipError(error: Error) -> Record{result: List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>!, errors: List<Error>} {
    return Record.new(result: error, errors: List.new(error))
}
flow TryPreparePip(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}) -> Record{result: List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>!, errors: List<Error>} onError CapturedPreparePipError {
    result = PreparePip(context)
    return Record.new(result: result, errors: List.new())
}

flow CapturedStorageReportError(error: Error) -> Record{result: Int!, errors: List<Error>} {
    return Record.new(result: error, errors: List.new(error))
}
flow TryStorageReport(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, du: File.Path) -> Record{result: Int!, errors: List<Error>} onError CapturedStorageReportError {
    result = StorageReport(context, du)
    return Record.new(result: result, errors: List.new())
}

flow CapturedCacheRemoveError(error: Error) -> Record{result: Bool!, errors: List<Error>} {
    return Record.new(result: error, errors: List.new(error))
}
flow TryCacheRemove(uid: Int, device: Int, cutoff: Int, entry: File.Entry) -> Record{result: Bool!, errors: List<Error>} onError CapturedCacheRemoveError {
    result = CacheRemove(uid, device, cutoff, entry)
    return Record.new(result: result, errors: List.new())
}

flow CapturedCacheProbeError(error: Error) -> Record{result: List<File.Path>!, errors: List<Error>} {
    return Record.new(result: error, errors: List.new(error))
}
flow TryCacheProbe(context: Process.Context, directory: File.Directory, paths: List<File.Path>) -> Record{result: List<File.Path>!, errors: List<Error>} onError CapturedCacheProbeError {
    result = CacheProbe(context, directory, paths)
    return Record.new(result: result, errors: List.new())
}

flow CapturedCacheChildDirectoriesError(error: Error) -> Record{result: List<File.Directory>!, errors: List<Error>} {
    return Record.new(result: error, errors: List.new(error))
}
flow TryCacheChildDirectories(directory: File.Directory, entry: File.Entry) -> Record{result: List<File.Directory>!, errors: List<Error>} onError CapturedCacheChildDirectoriesError {
