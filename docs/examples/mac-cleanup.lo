flow CapturedCacheObserveError(error: Error) -> Record{result: File.Scan!, errors: List<Error>} {
    return Record.new(result: error, errors: List.new(error))
}
flow TryCacheObserve(uid: Int, device: Int, directory: File.Directory) -> Record{result: File.Scan!, errors: List<Error>} onError CapturedCacheObserveError {
    result = CacheObserve(uid, device, directory)
    return Record.new(result: result, errors: List.new())
}

// Each selected identifier invokes one branch callback through Flow.fold.
flow SelectedChoice(wanted: Int, candidate: Int) -> Bool { return Math.eq(wanted, candidate) }

