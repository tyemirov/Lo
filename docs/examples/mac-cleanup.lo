flow TryCacheObserve(uid: Int, device: Int, directory: File.Directory) -> Record{result: File.Scan!, errors: List<Error>} onError CapturedCacheObserveError {
    result = CacheObserve(uid, device, directory)
    return Record.new(result: result, errors: List.new())
