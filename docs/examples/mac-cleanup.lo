// Cleanup application. The host supplies explicit file and process authority.
// Names, paths, command arguments, retention rules, and reports belong here.

flow And(previous: Bool, value: Bool) -> Bool {
    flow AndChoiceTest1(request: Record{selector: Bool, value: Bool}) -> Bool {
        return request.selector
    }

    flow AndChoiceResult1(request: Record{selector: Bool, value: Bool}) -> Bool {
        return request.value
    }

    flow AndChoiceDefault(request: Record{selector: Bool, value: Bool}) -> Bool {
        return false
    }

    return Record.new(selector: previous, value: value) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(AndChoiceTest1, AndChoiceResult1)),
        default: AndChoiceDefault
    ))
}
flow Or(previous: Bool, value: Bool) -> Bool {
    flow OrChoiceTest1(request: Record{selector: Bool, value: Bool}) -> Bool {
        return request.selector
    }

    flow OrChoiceResult1(request: Record{selector: Bool, value: Bool}) -> Bool {
        return true
    }

    flow OrChoiceDefault(request: Record{selector: Bool, value: Bool}) -> Bool {
        return request.value
    }

    return Record.new(selector: previous, value: value) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(OrChoiceTest1, OrChoiceResult1)),
        default: OrChoiceDefault
    ))
}
flow All(values: List<Bool>) -> Bool { return List.fold(values, true, And) }
flow Any(values: List<Bool>) -> Bool { return List.fold(values, false, Or) }
flow Not(value: Bool) -> Bool {
    flow NotChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow NotChoiceResult1(value: Bool) -> Bool {
        return false
    }

    flow NotChoiceDefault(value: Bool) -> Bool {
        return true
    }

    return value |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(NotChoiceTest1, NotChoiceResult1)),
        default: NotChoiceDefault
    ))
}

flow StringGroup(values: List<String>) -> List<String> { return values }
flow ConcatStrings(left: List<String>, right: List<String>) -> List<String> { return List.flat_map(List.new(left, right), StringGroup) }
flow PathGroup(values: List<File.Path>) -> List<File.Path> { return values }
flow ConcatPaths(left: List<File.Path>, right: List<File.Path>) -> List<File.Path> { return List.flat_map(List.new(left, right), PathGroup) }
flow IntGroup(values: List<Int>) -> List<Int> { return values }
flow ConcatInts(left: List<Int>, right: List<Int>) -> List<Int> { return List.flat_map(List.new(left, right), IntGroup) }
flow GlobGroup(values: List<Glob>) -> List<Glob> { return values }
flow ConcatGlobs(left: List<Glob>, right: List<Glob>) -> List<Glob> { return List.flat_map(List.new(left, right), GlobGroup) }
flow TaskGroup(values: List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>) -> List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}> { return values }
flow ConcatTasks(left: List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>, right: List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>) -> List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}> { return List.flat_map(List.new(left, right), TaskGroup) }
flow StorageRowGroup(values: List<Record{bytes: Int, path: String}>) -> List<Record{bytes: Int, path: String}> { return values }
flow ConcatStorageRows(left: List<Record{bytes: Int, path: String}>, right: List<Record{bytes: Int, path: String}>) -> List<Record{bytes: Int, path: String}> { return List.flat_map(List.new(left, right), StorageRowGroup) }

flow PathMemberStep(path: File.Path, found: Bool, candidate: File.Path) -> Bool {
    flow PathMemberStepChoiceTest1(request: Record{candidate: File.Path, path: File.Path, selector: Bool}) -> Bool {
        return request.selector
    }

    flow PathMemberStepChoiceResult1(request: Record{candidate: File.Path, path: File.Path, selector: Bool}) -> Bool {
        return true
    }

    flow PathMemberStepChoiceDefault(request: Record{candidate: File.Path, path: File.Path, selector: Bool}) -> Bool {
        return File.Path.eq(request.path, request.candidate)
    }

    return Record.new(selector: found, candidate: candidate, path: path) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(PathMemberStepChoiceTest1, PathMemberStepChoiceResult1)),
        default: PathMemberStepChoiceDefault
    ))
}
flow PathMember(paths: List<File.Path>, path: File.Path) -> Bool { return List.fold(paths, false, path, PathMemberStep) }
flow StringMemberStep(text: String, found: Bool, candidate: String) -> Bool {
    flow StringMemberStepChoiceTest1(request: Record{candidate: String, selector: Bool, text: String}) -> Bool {
        return request.selector
    }

    flow StringMemberStepChoiceResult1(request: Record{candidate: String, selector: Bool, text: String}) -> Bool {
        return true
    }

    flow StringMemberStepChoiceDefault(request: Record{candidate: String, selector: Bool, text: String}) -> Bool {
        return String.eq(request.text, request.candidate)
    }

    return Record.new(selector: found, candidate: candidate, text: text) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StringMemberStepChoiceTest1, StringMemberStepChoiceResult1)),
        default: StringMemberStepChoiceDefault
    ))
}
flow StringMember(values: List<String>, text: String) -> Bool { return List.fold(values, false, text, StringMemberStep) }
flow ScalarMemberStep(character: Scalar, found: Bool, candidate: Scalar) -> Bool {
    flow ScalarMemberStepChoiceTest1(request: Record{candidate: Scalar, character: Scalar, selector: Bool}) -> Bool {
        return request.selector
    }

    flow ScalarMemberStepChoiceResult1(request: Record{candidate: Scalar, character: Scalar, selector: Bool}) -> Bool {
        return true
    }

    flow ScalarMemberStepChoiceDefault(request: Record{candidate: Scalar, character: Scalar, selector: Bool}) -> Bool {
        return Scalar.eq(request.character, request.candidate)
    }

    return Record.new(selector: found, candidate: candidate, character: character) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ScalarMemberStepChoiceTest1, ScalarMemberStepChoiceResult1)),
        default: ScalarMemberStepChoiceDefault
    ))
}
flow ScalarMember(values: List<Scalar>, character: Scalar) -> Bool { return List.fold(values, false, character, ScalarMemberStep) }
flow IntMemberStep(number: Int, found: Bool, candidate: Int) -> Bool {
    flow IntMemberStepChoiceTest1(request: Record{candidate: Int, number: Int, selector: Bool}) -> Bool {
        return request.selector
    }

    flow IntMemberStepChoiceResult1(request: Record{candidate: Int, number: Int, selector: Bool}) -> Bool {
        return true
    }

    flow IntMemberStepChoiceDefault(request: Record{candidate: Int, number: Int, selector: Bool}) -> Bool {
        return Math.eq(request.number, request.candidate)
    }

    return Record.new(selector: found, candidate: candidate, number: number) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(IntMemberStepChoiceTest1, IntMemberStepChoiceResult1)),
        default: IntMemberStepChoiceDefault
    ))
}
flow IntMember(values: List<Int>, number: Int) -> Bool { return List.fold(values, false, number, IntMemberStep) }
flow UniquePathStep(paths: List<File.Path>, path: File.Path) -> List<File.Path> {
    flow UniquePathStepChoiceTest1(request: Record{path: File.Path, paths: List<File.Path>, selector: Bool}) -> Bool {
        return request.selector
    }

    flow UniquePathStepChoiceResult1(request: Record{path: File.Path, paths: List<File.Path>, selector: Bool}) -> List<File.Path> {
        return request.paths
    }

    flow UniquePathStepChoiceDefault(request: Record{path: File.Path, paths: List<File.Path>, selector: Bool}) -> List<File.Path> {
        return ConcatPaths(request.paths, List.new(request.path))
    }

    return Record.new(selector: PathMember(paths, path), path: path, paths: paths) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(UniquePathStepChoiceTest1, UniquePathStepChoiceResult1)),
        default: UniquePathStepChoiceDefault
    ))
}
flow UniquePaths(paths: List<File.Path>) -> List<File.Path> { return List.fold(paths, List.new(), UniquePathStep) }

flow PathChunk(paths: List<File.Path>, size: Int, start: Int) -> Record{next_state: Int, value: List<File.Path>}! {
    proposed = Math.add(start, size)
    end = Record.new(selector: Math.gt(proposed, List.length(paths)), paths: paths, proposed: proposed) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(PathChunkEndChoiceTest1, PathChunkEndChoiceResult1)),
        default: PathChunkEndChoiceDefault
    ))
    flow PathChunkEndChoiceTest1(request: Record{paths: List<File.Path>, proposed: Int, selector: Bool}) -> Bool {
        return request.selector
    }

    flow PathChunkEndChoiceResult1(request: Record{paths: List<File.Path>, proposed: Int, selector: Bool}) -> Int {
        return List.length(request.paths)
    }

    flow PathChunkEndChoiceDefault(request: Record{paths: List<File.Path>, proposed: Int, selector: Bool}) -> Int {
        return request.proposed
    }

    return Record.new(next_state: end, value: List.slice(paths, start, end))
}
flow PathChunks(paths: List<File.Path>, size: Int) -> List<List<File.Path>>! {
    valid = Require(Math.gt(size, 0), "Probe batch size must be positive")
    count = Math.div(Math.add(List.length(paths), Math.sub(size, 1)), size)
    return List.unfold(0, count, paths, size, PathChunk)
}
flow StringEqualAt(left: List<String>, right: List<String>, index: Int) -> Record{next_state: Int, value: Bool}! {
    return Record.new(next_state: Math.add(index, 1), value: String.eq(List.at(left, index), List.at(right, index)))
}
flow EqualLengthStrings(left: List<String>, right: List<String>) -> Bool! { return All(List.unfold(0, List.length(left), left, right, StringEqualAt)) }
flow StringsEqual(left: List<String>, right: List<String>) -> Bool! {
    flow StringsEqualChoiceTest1(request: Record{left: List<String>, right: List<String>, selector: Bool}) -> Bool {
        return request.selector
    }

    flow StringsEqualChoiceResult1(request: Record{left: List<String>, right: List<String>, selector: Bool}) -> Bool! {
        return EqualLengthStrings(request.left, request.right)
    }

    flow StringsEqualChoiceDefault(request: Record{left: List<String>, right: List<String>, selector: Bool}) -> Bool! {
        return false
    }

    return Record.new(selector: Math.eq(List.length(left), List.length(right)), left: left, right: right) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StringsEqualChoiceTest1, StringsEqualChoiceResult1)),
        default: StringsEqualChoiceDefault
    ))
}
flow TreeRowEqualAt(left: List<Record{relative: String, entry: File.Entry}>, right: List<Record{relative: String, entry: File.Entry}>, index: Int) -> Record{next_state: Int, value: Bool}! {
    return Record.new(next_state: Math.add(index, 1), value: SameTreeRow(List.at(left, index), List.at(right, index)))
}
flow EqualLengthTreeRows(left: List<Record{relative: String, entry: File.Entry}>, right: List<Record{relative: String, entry: File.Entry}>) -> Bool! { return All(List.unfold(0, List.length(left), left, right, TreeRowEqualAt)) }
flow TreeRowsEqual(left: List<Record{relative: String, entry: File.Entry}>, right: List<Record{relative: String, entry: File.Entry}>) -> Bool! {
    flow TreeRowsEqualChoiceTest1(request: Record{left: List<Record{entry: File.Entry, relative: String}>, right: List<Record{entry: File.Entry, relative: String}>, selector: Bool}) -> Bool {
        return request.selector
    }

    flow TreeRowsEqualChoiceResult1(request: Record{left: List<Record{entry: File.Entry, relative: String}>, right: List<Record{entry: File.Entry, relative: String}>, selector: Bool}) -> Bool! {
        return EqualLengthTreeRows(request.left, request.right)
    }

    flow TreeRowsEqualChoiceDefault(request: Record{left: List<Record{entry: File.Entry, relative: String}>, right: List<Record{entry: File.Entry, relative: String}>, selector: Bool}) -> Bool! {
        return false
    }

    return Record.new(selector: Math.eq(List.length(left), List.length(right)), left: left, right: right) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(TreeRowsEqualChoiceTest1, TreeRowsEqualChoiceResult1)),
        default: TreeRowsEqualChoiceDefault
    ))
}
flow JoinStringStep(separator: String, state: Record{first: Bool, text: String}, text: String) -> Record{first: Bool, text: String} {
    boundary = Record.new(selector: state.first, separator: separator) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(JoinStringStepBoundaryChoiceTest1, JoinStringStepBoundaryChoiceResult1)),
        default: JoinStringStepBoundaryChoiceDefault
    ))
    flow JoinStringStepBoundaryChoiceTest1(request: Record{selector: Bool, separator: String}) -> Bool {
        return request.selector
    }

    flow JoinStringStepBoundaryChoiceResult1(request: Record{selector: Bool, separator: String}) -> String {
        return ""
    }

    flow JoinStringStepBoundaryChoiceDefault(request: Record{selector: Bool, separator: String}) -> String {
        return request.separator
    }

    return Record.new(first: false, text: String.concat(state.text, boundary, text))
}
flow JoinStrings(values: List<String>, separator: String) -> String {
    joined = List.fold(values, Record.new(first: true, text: ""), separator, JoinStringStep)
    return joined.text
}

flow Print(text: String) -> Bool! {
    line = Console.Line.new("stdout", text, true)
    commit line
    return true
}

flow PrintError(text: String) -> Bool! {
    line = Console.Line.new("stderr", text, true)
    commit line
    return true
}

flow Fail(message: String) -> Int! {
    return Error.new("Application.InvalidState", message, Record.new())
}

flow Require(condition: Bool, message: String) -> Bool! {
    flow RequireChoiceTest1(request: Record{message: String, selector: Bool}) -> Bool {
        return request.selector
    }

    flow RequireChoiceResult1(request: Record{message: String, selector: Bool}) -> Bool! {
        return true
    }

    flow RequireChoiceDefault(request: Record{message: String, selector: Bool}) -> Bool! {
        return Error.new("Application.InvalidState", request.message, Record.new())
    }

    return Record.new(selector: condition, message: message) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RequireChoiceTest1, RequireChoiceResult1)),
        default: RequireChoiceDefault
    ))
}

flow PathText(path: File.Path) -> String { return File.Path.to_string(path) }

flow HumanSize(value: Int) -> String! {
    gib = Float.div(Int.to_float(value), 1073741824.0)
    return String.concat(Float.format_fixed(gib, 2), " GiB")
}

flow Run(context: Process.Context, executable: Process.Executable, arguments: List<String>, output: String, timeout_seconds: Int) -> Process.Result! {
    command = Process.Command.new(context, executable, arguments, Bytes.new(""))
    timed = Process.Command.with_timeout(command, Math.mul(timeout_seconds, 1000))
    configured = Process.Command.with_output(timed, output)
    result = commit configured
    return result
}

flow RequireSuccess(result: Process.Result) -> Process.Result! {
    code = Process.Termination.exit_code(result.termination)
    flow RequireSuccessChoiceTest1(request: Record{code: Int, result: Process.Result, selector: Int}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow RequireSuccessChoiceResult1(request: Record{code: Int, result: Process.Result, selector: Int}) -> Process.Result! {
        return request.result
    }

    flow RequireSuccessChoiceDefault(request: Record{code: Int, result: Process.Result, selector: Int}) -> Process.Result! {
        return Error.new("Application.CommandFailed", String.concat("Command exited with status ", Int.to_string(request.code)), Record.new(result: request.result))
    }

    return Record.new(selector: code, code: code, result: result) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RequireSuccessChoiceTest1, RequireSuccessChoiceResult1)),
        default: RequireSuccessChoiceDefault
    ))
}

flow DiscoveryError(error: Error) -> Record{executables: List<Process.Executable>!} {
    flow DiscoveryErrorChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "Process.ExecutableAbsent")
    }

    flow DiscoveryErrorChoiceResult1(request: Record{error: Error, selector: String}) -> List<Process.Executable>! {
        return List.new()
    }

    flow DiscoveryErrorChoiceDefault(request: Record{error: Error, selector: String}) -> List<Process.Executable>! {
        return request.error

    }

    return Record.new(executables: Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(DiscoveryErrorChoiceTest1, DiscoveryErrorChoiceResult1)),
        default: DiscoveryErrorChoiceDefault
    )))
}

flow OptionalExecutable(context: Process.Context, name: String) -> Record{executables: List<Process.Executable>!} onError DiscoveryError {
    executable = Process.Executable.resolve(context, name)
    return Record.new(executables: List.new(executable))
}

flow Lsof(context: Process.Context) -> Process.Executable! {
    return Process.Executable.resolve(context, "lsof")
}

flow Task(label: String, operation: String, path: File.Path, arguments: List<String>) -> Record{label: String, operation: String, path: File.Path, arguments: List<String>} {
    return Record.new(label: label, operation: operation, path: path, arguments: arguments)
}

flow CommandTask(label: String, arguments: List<String>) -> Record{label: String, operation: String, path: File.Path, arguments: List<String>} {
    return Task(label, "command", File.Path.new("."), arguments)
}

flow PathTask(operation: String, path: File.Path) -> Record{label: String, operation: String, path: File.Path, arguments: List<String>} {
    return Task(PathText(path), operation, path, List.new())
}

flow CacheTask(path: File.Path) -> Record{label: String, operation: String, path: File.Path, arguments: List<String>} {
    return PathTask("cache", path)
}



flow CommandTasks() -> List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}> {
    return List.new(
        CommandTask("npm", List.new("npm", "cache", "clean", "--force")),
        CommandTask("Go", List.new("go", "clean", "-cache", "-testcache")),
        CommandTask("uv", List.new("uv", "cache", "clean", "--force")),
        CommandTask("pnpm", List.new("pnpm", "store", "prune", "--yes"))
    )
}

flow InitialWorkflow() -> Record{failures: List<String>, estimates: List<Int>} {
    return Record.new(failures: List.new(), estimates: List.new())
}

flow Action(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, executable: Process.Executable, arguments: List<String>, display_arguments: List<String>) -> Int! {
    prefix = context.apply |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ActionPrefixChoiceTest1, ActionPrefixChoiceResult1)),
        default: ActionPrefixChoiceDefault
    ))
    printed = Print(String.concat(prefix, Process.Arguments.format_shell(display_arguments)))
    selector_1 = context.apply
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ActionChoice_1ChoiceTest1, ActionChoice_1ChoiceResult1)),
        default: ActionChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, arguments, context, executable, ActionChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, ActionChoice1Branch2)
    flow ActionPrefixChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow ActionPrefixChoiceResult1(value: Bool) -> String {
        return "RUN  "
    }

    flow ActionPrefixChoiceDefault(value: Bool) -> String {
        return "PLAN "
    }

    flow ActionChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow ActionChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow ActionChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow ApplyAction(context: Process.Context, executable: Process.Executable, arguments: List<String>) -> Int! {
    result = Run(context, executable, arguments, "forward", 1800) |> RequireSuccess()
    return 0
}

flow RunPresentCommand(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, task: Record{label: String, operation: String, path: File.Path, arguments: List<String>}, executable: Process.Executable) -> Int! {
    return Action(context, executable, List.slice(task.arguments, 1, List.length(task.arguments)), task.arguments)
}

flow SkipCommand(task: Record{label: String, operation: String, path: File.Path, arguments: List<String>}) -> Int! {
    printed = Print(String.concat("SKIP ", task.label, ": not installed"))
    return 0
}

flow Command(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, task: Record{label: String, operation: String, path: File.Path, arguments: List<String>}) -> Int! {
    discovered = OptionalExecutable(context.process, List.at(task.arguments, 0))
    executables = discovered.executables
    selector_1 = List.length(executables)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(CommandChoice_1ChoiceTest1, CommandChoice_1ChoiceResult1)),
        default: CommandChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, task, CommandChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, context, executables, task, CommandChoice1Branch2)
    flow CommandChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow CommandChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow CommandChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow ProbeTerminationError(error: Error) -> Int! {
    flow ProbeTerminationErrorChoiceTest1(request: Record{error: Error, selector: String}) -> Bool {
        return String.eq(request.selector, "Process.TerminationKind")
    }

    flow ProbeTerminationErrorChoiceResult1(request: Record{error: Error, selector: String}) -> Int! {
        return -1
    }

    flow ProbeTerminationErrorChoiceDefault(request: Record{error: Error, selector: String}) -> Int! {
        return request.error
    }

    return Record.new(selector: error.kind, error: error) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ProbeTerminationErrorChoiceTest1, ProbeTerminationErrorChoiceResult1)),
        default: ProbeTerminationErrorChoiceDefault
    ))
}

flow ProbeExitCode(termination: Process.Termination) -> Record{code: Int!} onError ProbeTerminationWrapped {
    return Record.new(code: Process.Termination.exit_code(termination))
}

flow ProbeTerminationWrapped(error: Error) -> Record{code: Int!} {
    return Record.new(code: ProbeTerminationError(error))
}

flow PipWithPython(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, executable: Process.Executable) -> List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>! {
    result = Run(context.process, executable, List.new("-m", "pip", "--version"), "capture", 60)
    termination = ProbeExitCode(result.termination)
    flow PipWithPythonChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow PipWithPythonChoiceResult1(value: Int) -> List<Record{arguments: List<String>, label: String, operation: String, path: File.Path}>! {
        return List.new(CommandTask("pip", List.new("python3", "-m", "pip", "cache", "purge")))
    }

    flow PipWithPythonChoiceDefault(value: Int) -> List<Record{arguments: List<String>, label: String, operation: String, path: File.Path}>! {
        return List.new()
    }

    return termination.code |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(PipWithPythonChoiceTest1, PipWithPythonChoiceResult1)),
        default: PipWithPythonChoiceDefault
    ))
}

flow DetectPip(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}) -> List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>! {
    discovered = OptionalExecutable(context.process, "python3")
    executables = discovered.executables
    selector_1 = List.length(executables)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(DetectPipChoice_1ChoiceTest1, DetectPipChoice_1ChoiceResult1)),
        default: DetectPipChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), List.new(), DetectPipChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, context, executables, DetectPipChoice1Branch2)
    flow DetectPipChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow DetectPipChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow DetectPipChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow PreviewPip() -> List<Record{label: String, operation: String, path: File.Path, arguments: List<String>}>! {
    printed = Print("PLAN pip cache purge (if python3 -m pip is installed)")
    return List.new()
}

flow RejectAmbient(context: Process.Context, state: Bool, name: String) -> Bool! {
    captured = TryEnvironmentValue(context, name)
    flow RejectAmbientChoiceTest1(request: Record{captured: Record{errors: List<Error>, result: String!}, name: String, selector: Int, state: Bool}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow RejectAmbientChoiceResult1(request: Record{captured: Record{errors: List<Error>, result: String!}, name: String, selector: Int, state: Bool}) -> Bool! {
        return Require(String.eq(request.captured.result, ""), String.concat("Unset ", request.name, "; mac-cleanup uses desktop-linux"))
    }

    flow RejectAmbientChoiceDefault(request: Record{captured: Record{errors: List<Error>, result: String!}, name: String, selector: Int, state: Bool}) -> Bool! {
        return AbsentEnvironment(request.state, List.at(request.captured.errors, 0))
    }

    return Record.new(selector: List.length(captured.errors), captured: captured, name: name, state: state) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RejectAmbientChoiceTest1, RejectAmbientChoiceResult1)),
        default: RejectAmbientChoiceDefault
    ))
}

flow EnvironmentValue(context: Process.Context, name: String) -> String! {
    return Process.Context.environment_value(context, name)
}

flow AbsentEnvironment(state: Bool, error: Error) -> Bool! {
    flow AbsentEnvironmentChoiceTest1(request: Record{error: Error, selector: String, state: Bool}) -> Bool {
        return String.eq(request.selector, "Process.EnvironmentAbsent")
    }

    flow AbsentEnvironmentChoiceResult1(request: Record{error: Error, selector: String, state: Bool}) -> Bool! {
        return request.state
    }

    flow AbsentEnvironmentChoiceDefault(request: Record{error: Error, selector: String, state: Bool}) -> Bool! {
        return request.error
    }

    return Record.new(selector: error.kind, error: error, state: state) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(AbsentEnvironmentChoiceTest1, AbsentEnvironmentChoiceResult1)),
        default: AbsentEnvironmentChoiceDefault
    ))
}

flow DockerCommand(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, executable: Process.Executable, arguments: List<String>, output: String) -> Process.Result! {
    return Run(context.process, executable, ConcatStrings(List.new("--context", "desktop-linux"), arguments), output, 1800) |> RequireSuccess()
}

flow BuilderFirst(tokens: List<String>) -> List<String>! {
    flow BuilderFirstChoiceTest1(request: Record{selector: Int, tokens: List<String>}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow BuilderFirstChoiceResult1(request: Record{selector: Int, tokens: List<String>}) -> List<String>! {
        return List.new()
    }

    flow BuilderFirstChoiceDefault(request: Record{selector: Int, tokens: List<String>}) -> List<String>! {
        return List.slice(request.tokens, 0, 1)
    }

    return Record.new(selector: List.length(tokens), tokens: tokens) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuilderFirstChoiceTest1, BuilderFirstChoiceResult1)),
        default: BuilderFirstChoiceDefault
    ))
}

flow BuilderSuffix(key: String, line: String) -> Record{pending: Bool, values: List<String>}! {
    suffix = String.slice(line, Math.add(String.length(key), 1), String.length(line))
    spaced = BuilderSuffixSpacedChoiceValue(Record.new(selector: String.length(suffix), suffix: suffix) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuilderSuffixSpacedChoiceTest1, BuilderSuffixSpacedChoiceResult1)),
        default: BuilderSuffixSpacedChoiceDefault
    )))
    tokens = String.split_whitespace(suffix)
    flow BuilderSuffixSpacedChoiceTest1(request: Record{selector: Int, suffix: String}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow BuilderSuffixSpacedChoiceResult1(request: Record{selector: Int, suffix: String}) -> Bool! {
        return true
    }

    flow BuilderSuffixSpacedChoiceDefault(request: Record{selector: Int, suffix: String}) -> Bool! {
        return String.is_whitespace(String.slice(request.suffix, 0, 1))
    }

    flow BuilderSuffixSpacedChoiceValue(value: Bool) -> Bool { return value }

    flow BuilderSuffixChoiceTest1(request: Record{selector: Bool, tokens: List<String>}) -> Bool {
        return request.selector
    }

    flow BuilderSuffixChoiceResult1(request: Record{selector: Bool, tokens: List<String>}) -> Record{pending: Bool, values: List<String>}! {
        return Record.new(pending: Math.eq(List.length(request.tokens), 0), values: BuilderFirst(request.tokens))
    }

    flow BuilderSuffixChoiceDefault(request: Record{selector: Bool, tokens: List<String>}) -> Record{pending: Bool, values: List<String>}! {
        return Record.new(pending: false, values: List.new())
    }

    return Record.new(selector: spaced, tokens: tokens) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuilderSuffixChoiceTest1, BuilderSuffixChoiceResult1)),
        default: BuilderSuffixChoiceDefault
    ))
}

flow BuilderValue(key: String, line: String) -> Record{pending: Bool, values: List<String>}! {
    flow BuilderValueChoiceTest1(request: Record{key: String, line: String, selector: Bool}) -> Bool {
        return request.selector
    }

    flow BuilderValueChoiceResult1(request: Record{key: String, line: String, selector: Bool}) -> Record{pending: Bool, values: List<String>}! {
        return BuilderSuffix(request.key, request.line)
    }

    flow BuilderValueChoiceDefault(request: Record{key: String, line: String, selector: Bool}) -> Record{pending: Bool, values: List<String>}! {
        return Record.new(pending: false, values: List.new())
    }

    return Record.new(selector: String.starts_with(line, String.concat(key, ":")), key: key, line: line) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuilderValueChoiceTest1, BuilderValueChoiceResult1)),
        default: BuilderValueChoiceDefault
    ))
}

flow BuilderField(key: String, state: Record{pending: Bool, values: List<String>}, line: String) -> Record{pending: Bool, values: List<String>}! {
    prefix = BuilderValue(key, line)
    continued = String.split_whitespace(line)
    flow BuilderFieldChoiceTest1(request: Record{continued: List<String>, prefix: Record{pending: Bool, values: List<String>}, selector: Bool, state: Record{pending: Bool, values: List<String>}}) -> Bool {
        return request.selector
    }

    flow BuilderFieldChoiceResult1(request: Record{continued: List<String>, prefix: Record{pending: Bool, values: List<String>}, selector: Bool, state: Record{pending: Bool, values: List<String>}}) -> Record{pending: Bool, values: List<String>}! {
        return Record.new(pending: Math.eq(List.length(request.continued), 0), values: ConcatStrings(request.state.values, BuilderFirst(request.continued)))
    }

    flow BuilderFieldChoiceDefault(request: Record{continued: List<String>, prefix: Record{pending: Bool, values: List<String>}, selector: Bool, state: Record{pending: Bool, values: List<String>}}) -> Record{pending: Bool, values: List<String>}! {
        return Record.new(pending: request.prefix.pending, values: ConcatStrings(request.state.values, request.prefix.values))
    }

    return Record.new(selector: state.pending, continued: continued, prefix: prefix, state: state) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(BuilderFieldChoiceTest1, BuilderFieldChoiceResult1)),
        default: BuilderFieldChoiceDefault
    ))
}

flow StrictBuilderField(key: String, state: Record{pending: Bool, values: List<String>}, line: String) -> Record{pending: Bool, values: List<String>}! {
    continued = String.split_whitespace(line)
    key_line = String.starts_with(line, String.concat(key, ":"))
    suffix = Record.new(selector: key_line, key: key, line: line) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StrictBuilderFieldSuffixChoiceTest1, StrictBuilderFieldSuffixChoiceResult1)),
        default: StrictBuilderFieldSuffixChoiceDefault
    ))
    spaced = StrictBuilderFieldSpacedChoiceValue(Record.new(selector: String.length(suffix), suffix: suffix) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StrictBuilderFieldSpacedChoiceTest1, StrictBuilderFieldSpacedChoiceResult1)),
        default: StrictBuilderFieldSpacedChoiceDefault
    )))
    valid = Record.new(selector: state.pending, continued: continued, key_line: key_line, spaced: spaced, suffix: suffix) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(StrictBuilderFieldValidChoiceTest1, StrictBuilderFieldValidChoiceResult1)),
        default: StrictBuilderFieldValidChoiceDefault
    ))
    checked = Require(valid, String.concat("Malformed Docker builder field: ", key))
    flow StrictBuilderFieldSuffixChoiceTest1(request: Record{key: String, line: String, selector: Bool}) -> Bool {
        return request.selector
    }

    flow StrictBuilderFieldSuffixChoiceResult1(request: Record{key: String, line: String, selector: Bool}) -> String! {
        return String.slice(request.line, Math.add(String.length(request.key), 1), String.length(request.line))
    }

    flow StrictBuilderFieldSuffixChoiceDefault(request: Record{key: String, line: String, selector: Bool}) -> String! {
        return ""
    }

    flow StrictBuilderFieldSpacedChoiceTest1(request: Record{selector: Int, suffix: String}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow StrictBuilderFieldSpacedChoiceResult1(request: Record{selector: Int, suffix: String}) -> Bool! {
        return true
    }

    flow StrictBuilderFieldSpacedChoiceDefault(request: Record{selector: Int, suffix: String}) -> Bool! {
        return String.is_whitespace(String.slice(request.suffix, 0, 1))
    }

    flow StrictBuilderFieldSpacedChoiceValue(value: Bool) -> Bool { return value }

    flow StrictBuilderFieldValidChoiceTest1(request: Record{continued: List<String>, key_line: Bool, selector: Bool, spaced: Bool, suffix: String}) -> Bool {
        return request.selector
    }

    flow StrictBuilderFieldValidChoiceResult1(request: Record{continued: List<String>, key_line: Bool, selector: Bool, spaced: Bool, suffix: String}) -> Bool {
        return Math.lte(List.length(request.continued), 1)
    }

    flow StrictBuilderFieldValidChoice2Test1(request: Record{selector: Bool, spaced: Bool, suffix: String}) -> Bool {
        return request.selector
    }

    flow StrictBuilderFieldValidChoice2Result1(request: Record{selector: Bool, spaced: Bool, suffix: String}) -> Bool {
        return All(List.new(request.spaced, Math.lte(List.length(String.split_whitespace(request.suffix)), 1)))
    }

    flow StrictBuilderFieldValidChoice2Default(request: Record{selector: Bool, spaced: Bool, suffix: String}) -> Bool {
        return true
    }

    flow StrictBuilderFieldValidChoiceDefault(request: Record{continued: List<String>, key_line: Bool, selector: Bool, spaced: Bool, suffix: String}) -> Bool {
        return Record.new(selector: request.key_line, spaced: request.spaced, suffix: request.suffix) |> Match.apply(Match.new(
            cases: List.new(Match.Case.new(StrictBuilderFieldValidChoice2Test1, StrictBuilderFieldValidChoice2Result1)),
            default: StrictBuilderFieldValidChoice2Default
        ))
    }

    return BuilderField(key, state, line)
}

flow DockerApply(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, executable: Process.Executable) -> Int! {
    inspected = DockerCommand(context, executable, List.new("context", "inspect", "desktop-linux"), "capture")
    context_output = Require(Math.eq(Bytes.length(inspected.stderr), 0), "Docker context inspection wrote to stderr")
    contexts = JSON.decode(inspected.stdout)
    context_count = Require(Math.eq(JSON.length(contexts), 1), "Expected one selected Docker context")
    selected = JSON.at(contexts, 0)
    context_name = Require(String.eq(JSON.get(selected, "Name") |> JSON.string(), "desktop-linux"), "Expected the desktop-linux Docker context")
    endpoint = JSON.get(selected, "Endpoints") |> JSON.get("docker") |> JSON.get("Host") |> JSON.string()
    local = Require(All(List.new(String.starts_with(endpoint, "unix:///"), Math.gt(String.length(endpoint), 8), All(List.map(endpoint, UnambiguousCharacter)))), String.concat("Refusing invalid or nonlocal Docker endpoint: ", endpoint))
    inspected_builder = DockerCommand(context, executable, List.new("buildx", "inspect", "desktop-linux"), "capture")
    builder_output = Require(Math.eq(Bytes.length(inspected_builder.stderr), 0), "Docker builder inspection wrote to stderr")
    builder_text = String.replace_all(String.replace_all(String.FromBytes.new(inspected_builder.stdout), "\r\n", "\n"), "\r", "\n")
    lines = String.split(builder_text, "\n")
    drivers_found = Flow.fold(lines, Record.new(pending: false, values: List.new()), "Driver", StrictBuilderField)
    endpoints_found = Flow.fold(lines, Record.new(pending: false, values: List.new()), "Endpoint", StrictBuilderField)
    drivers = drivers_found.values
    endpoints = endpoints_found.values
    driver = Require(All(List.new(Not(drivers_found.pending), StringsEqual(drivers, List.new("docker")))), "Expected one Docker-driver builder on the selected local context")
    builder_endpoint = Require(All(List.new(Not(endpoints_found.pending), StringsEqual(endpoints, List.new("desktop-linux")))), "Expected one Docker-driver builder on the selected local context")
    printed = Print(String.concat("Docker target: desktop-linux (", endpoint, ")"))
    usage = DockerCommand(context, executable, List.new("system", "df"), "forward")
    build = Action(context, executable, List.new("--context", "desktop-linux", "buildx", "prune", "--builder", "desktop-linux", "--all", "--force"), List.new("docker", "--context", "desktop-linux", "buildx", "prune", "--builder", "desktop-linux", "--all", "--force"))
    images = Action(context, executable, List.new("--context", "desktop-linux", "image", "prune", "--all", "--force"), List.new("docker", "--context", "desktop-linux", "image", "prune", "--all", "--force"))
    return 0
}

flow DockerPreview(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, executable: Process.Executable) -> Int! {
    build = Action(context, executable, List.new("--context", "desktop-linux", "buildx", "prune", "--builder", "desktop-linux", "--all", "--force"), List.new("docker", "--context", "desktop-linux", "buildx", "prune", "--builder", "desktop-linux", "--all", "--force"))
    images = Action(context, executable, List.new("--context", "desktop-linux", "image", "prune", "--all", "--force"), List.new("docker", "--context", "desktop-linux", "image", "prune", "--all", "--force"))
    printed = Print("Docker context/builder validation happens before actual cleanup")
    return 0
}

flow DockerPresent(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, executable: Process.Executable) -> Int! {
    clean = Flow.fold(List.new("DOCKER_HOST", "DOCKER_CONTEXT", "BUILDX_BUILDER"), true, context.process, RejectAmbient)
    selector_1 = context.apply
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(DockerPresentChoice_1ChoiceTest1, DockerPresentChoice_1ChoiceResult1)),
        default: DockerPresentChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, context, executable, DockerPresentChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, context, executable, DockerPresentChoice1Branch2)
    flow DockerPresentChoice_1ChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow DockerPresentChoice_1ChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow DockerPresentChoice_1ChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow DockerAbsent() -> Int! {
    printed = Print("SKIP Docker: not installed")
    return 0
}

flow Docker(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}) -> Int! {
    discovered = OptionalExecutable(context.process, "docker")
    executables = discovered.executables
    selector_1 = List.length(executables)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(DockerChoice_1ChoiceTest1, DockerChoice_1ChoiceResult1)),
        default: DockerChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, DockerChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, context, executables, DockerChoice1Branch2)
    flow DockerChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow DockerChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow DockerChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow CleanTempRoot(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, count: Int, root: File.Path) -> Int! {
    cleaned = StaleFiles(context, root, List.new("*.tmp", "*.temp"), 7)
    return Math.add(count, cleaned)
}

flow PreviewTemporary(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, shared: File.Path, previous: Int, selected: Int) -> Int! {
    printed = Print("PLAN per-user temporary files: discovery deferred until cleanup")
    return CleanTempRoot(context, 0, shared)
}
flow ApplyTemporary(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, shared: File.Path, prefix: String, getconf: File.Path, previous: Int, selected: Int) -> Int! {
    roots = TempRoots(context, shared, prefix, getconf)
    return Flow.fold(roots, 0, context, CleanTempRoot)
}
flow TemporaryFiles(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, shared: File.Path, prefix: String, getconf: File.Path) -> Int! {
    choice = context.apply |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(TemporaryFilesChoiceChoiceTest1, TemporaryFilesChoiceChoiceResult1)),
        default: TemporaryFilesChoiceChoiceDefault
    ))
    applied = Flow.fold(List.filter(List.new(choice), 1, SelectedChoice), 0, context, shared, prefix, getconf, ApplyTemporary)
    flow TemporaryFilesChoiceChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow TemporaryFilesChoiceChoiceResult1(value: Bool) -> Int {
        return 1
    }

    flow TemporaryFilesChoiceChoiceDefault(value: Bool) -> Int {
        return 2
    }

    return Flow.fold(List.filter(List.new(choice), 2, SelectedChoice), applied, context, shared, PreviewTemporary)
}

flow Perform(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, task: Record{label: String, operation: String, path: File.Path, arguments: List<String>}) -> Int! {
    selector_1 = task.operation
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(
            Match.Case.new(PerformChoice_1ChoiceTest1, PerformChoice_1ChoiceResult1),
            Match.Case.new(PerformChoice_1ChoiceTest2, PerformChoice_1ChoiceResult2),
            Match.Case.new(PerformChoice_1ChoiceTest3, PerformChoice_1ChoiceResult3),
            Match.Case.new(PerformChoice_1ChoiceTest4, PerformChoice_1ChoiceResult4),
            Match.Case.new(PerformChoice_1ChoiceTest5, PerformChoice_1ChoiceResult5),
            Match.Case.new(PerformChoice_1ChoiceTest6, PerformChoice_1ChoiceResult6),
        ),
        default: PerformChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), 0, context, task, PerformChoice1Branch1)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, context, task, PerformChoice1Branch2)
    choice_1_result_3 = Flow.fold(List.filter(List.new(choice_1), 3, SelectedChoice), choice_1_result_2, context, task, PerformChoice1Branch3)
    choice_1_result_5 = Flow.fold(List.filter(List.new(choice_1), 5, SelectedChoice), choice_1_result_3, context, task, PerformChoice1Branch5)
    choice_1_result_6 = Flow.fold(List.filter(List.new(choice_1), 6, SelectedChoice), choice_1_result_5, context, PerformChoice1Branch6)
    choice_1_result_7 = Flow.fold(List.filter(List.new(choice_1), 7, SelectedChoice), choice_1_result_6, context, PerformChoice1Branch7)
    choice_1_result_8 = Flow.fold(List.filter(List.new(choice_1), 8, SelectedChoice), choice_1_result_7, PerformChoice1Branch8)
    flow PerformChoice_1ChoiceTest1(value: String) -> Bool {
        return String.eq(value, "command")
    }

    flow PerformChoice_1ChoiceResult1(value: String) -> Int {
        return 1
    }

    flow PerformChoice_1ChoiceTest2(value: String) -> Bool {
        return String.eq(value, "files")
    }

    flow PerformChoice_1ChoiceResult2(value: String) -> Int {
        return 2
    }

    flow PerformChoice_1ChoiceTest3(value: String) -> Bool {
        return String.eq(value, "cache")
    }

    flow PerformChoice_1ChoiceResult3(value: String) -> Int {
        return 3
    }

    flow PerformChoice_1ChoiceTest4(value: String) -> Bool {
        return String.eq(value, "temp")
    }

    flow PerformChoice_1ChoiceResult4(value: String) -> Int {
        return 5
    }

    flow PerformChoice_1ChoiceTest5(value: String) -> Bool {
        return String.eq(value, "docker")
    }

    flow PerformChoice_1ChoiceResult5(value: String) -> Int {
        return 6
    }

    flow PerformChoice_1ChoiceTest6(value: String) -> Bool {
        return String.eq(value, "logs")
    }

    flow PerformChoice_1ChoiceResult6(value: String) -> Int {
        return 7
    }

    flow PerformChoice_1ChoiceDefault(value: String) -> Int {
        return 8
    }

    return choice_1_result_8
}

flow AddFailure(state: Record{failures: List<String>, estimates: List<Int>}, label: String, error: Error) -> Record{failures: List<String>, estimates: List<Int>}! {
    printed = PrintError(String.concat("FAILED ", label, ": ", error.message))
    return Record.new(failures: ConcatStrings(state.failures, List.new(label)), estimates: state.estimates)
}

flow Attempt(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, state: Record{failures: List<String>, estimates: List<Int>}, task: Record{label: String, operation: String, path: File.Path, arguments: List<String>}) -> Record{failures: List<String>, estimates: List<Int>}! {
    captured = TryPerform(context, task)
    return RecordOutcome(state, task.label, captured)
}

flow RecordOutcome(state: Record{failures: List<String>, estimates: List<Int>}, label: String, captured: Record{result: Int!, errors: List<Error>}) -> Record{failures: List<String>, estimates: List<Int>}! {
    selector_1 = List.length(captured.errors)
    choice_1 = selector_1 |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(RecordOutcomeChoice_1ChoiceTest1, RecordOutcomeChoice_1ChoiceResult1)),
        default: RecordOutcomeChoice_1ChoiceDefault
    ))
    choice_1_result_1 = Flow.fold(List.filter(List.new(choice_1), 1, SelectedChoice), state, captured, state, RecordSuccess)
    choice_1_result_2 = Flow.fold(List.filter(List.new(choice_1), 2, SelectedChoice), choice_1_result_1, captured, state, label, RecordFailure)
    flow RecordOutcomeChoice_1ChoiceTest1(value: Int) -> Bool {
        return Math.eq(value, 0)
    }

    flow RecordOutcomeChoice_1ChoiceResult1(value: Int) -> Int {
        return 1
    }

    flow RecordOutcomeChoice_1ChoiceDefault(value: Int) -> Int {
        return 2
    }

    return choice_1_result_2
}

flow Xcode(context: Record{apply: Bool, home: File.Path, uid: Int, process: Process.Context}, state: Record{failures: List<String>, estimates: List<Int>}) -> Record{failures: List<String>, estimates: List<Int>}! {
