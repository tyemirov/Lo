// CPU training with explicit immutable state and 20 SGD updates for a 16-16-8 network and 32 examples.

flow Forward(inputs: Tensor<FP32>, values: Record{b1: Tensor<FP32>, b2: Tensor<FP32>, w1: Tensor<FP32>, w2: Tensor<FP32>}) -> Tensor<FP32>! {
  hidden_linear = Tensor.matmul(inputs, values.w1)
  hidden_biased = Tensor.add(hidden_linear, values.b1)
  hidden = Tensor.relu(hidden_biased)
  output_linear = Tensor.matmul(hidden, values.w2)
  return Tensor.add(output_linear, values.b2)
}

flow Loss(inputs: Tensor<FP32>, targets: Tensor<FP32>, values: Record{b1: Tensor<FP32>, b2: Tensor<FP32>, w1: Tensor<FP32>, w2: Tensor<FP32>}) -> Tensor<FP32>! {
  predictions = Forward(inputs, values)
  residual = Tensor.sub(predictions, targets)
  squared = Tensor.mul(residual, residual)
  return Tensor.mean(squared, List.new(0, 1))
}

flow Counter(state: Int) -> Record{value: Int, next_state: Int} {
  return Record.new(value: state, next_state: Math.add(state, 1))
}

flow TrainStep(inputs: Tensor<FP32>, targets: Tensor<FP32>, state: Optimizer.SGD.State<Record{b1: Tensor<FP32>, b2: Tensor<FP32>, w1: Tensor<FP32>, w2: Tensor<FP32>}>, index: Int) -> Optimizer.SGD.State<Record{b1: Tensor<FP32>, b2: Tensor<FP32>, w1: Tensor<FP32>, w2: Tensor<FP32>}>! {
  values = Parameters.values(state.parameters)
  differentiated = Autodiff.grad(values, inputs, targets, Loss)
  gradients = Gradients.new(state.parameters, differentiated.gradients)
  return Optimizer.SGD.step(state, gradients)
}

