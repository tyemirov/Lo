flow Run() -> Optimizer.AdamW.State<Record{x: Tensor<FP32>}>! { x=Tensor.new(List.new(2.0),List.new()); p=Parameters.new(Record.new(x:x)); config=Optimizer.AdamW.Config.new(0.25,0.5,0.5,0.5,0.5); state=Optimizer.AdamW.State.new(p,config); gradients=Gradients.new(p,Record.new(x:x)); return Optimizer.AdamW.step(state,gradients) }
return Run()
