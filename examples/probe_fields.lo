flow ProbeRequire(condition: Bool, reason: String) -> Bool! {
    flow ProbeRequireChoiceTest1(request: Record{reason: String, selector: Bool}) -> Bool {
        return request.selector
    }

    flow ProbeRequireChoiceResult1(request: Record{reason: String, selector: Bool}) -> Bool! {
        return true
    }

    flow ProbeRequireChoiceDefault(request: Record{reason: String, selector: Bool}) -> Bool! {
        return Error.new("Probe.InvalidFields", request.reason, Record.new())
    }

    return Record.new(selector: condition, reason: reason) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ProbeRequireChoiceTest1, ProbeRequireChoiceResult1)),
        default: ProbeRequireChoiceDefault
    ))
}

flow ProbeAnd(previous: Bool, value: Bool) -> Bool {
    flow ProbeAndChoiceTest1(request: Record{selector: Bool, value: Bool}) -> Bool {
        return request.selector
    }

    flow ProbeAndChoiceResult1(request: Record{selector: Bool, value: Bool}) -> Bool {
        return request.value
    }

    flow ProbeAndChoiceDefault(request: Record{selector: Bool, value: Bool}) -> Bool {
        return false
    }

    return Record.new(selector: previous, value: value) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ProbeAndChoiceTest1, ProbeAndChoiceResult1)),
        default: ProbeAndChoiceDefault
    ))
}

flow ProbeDigit(character: Scalar) -> Bool {
    return Range.contains(Range.new(Scalar.new("0"), Scalar.new("9"), true, true), character)
}

flow PathGroup(paths: List<File.Path>) -> List<File.Path> {
    return paths
}

flow ConcatPaths(left: List<File.Path>, right: List<File.Path>) -> List<File.Path> {
    return List.flat_map(List.new(left, right), PathGroup)
}

flow PathMemberStep(path: File.Path, found: Bool, candidate: File.Path) -> Bool {
    flow PathMemberStepChoiceTest1(request: Record{candidate: File.Path, path: File.Path, selector: Bool}) -> Bool {
        return request.selector
    }

    flow PathMemberStepChoiceResult1(request: Record{candidate: File.Path, path: File.Path, selector: Bool}) -> Bool {
        return true
    }

    flow PathMemberStepChoiceDefault(request: Record{candidate: File.Path, path: File.Path, selector: Bool}) -> Bool {
        return File.Path.eq(request.path, request.candidate)
    }

    return Record.new(selector: found, candidate: candidate, path: path) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(PathMemberStepChoiceTest1, PathMemberStepChoiceResult1)),
        default: PathMemberStepChoiceDefault
    ))
}

flow PathMember(paths: List<File.Path>, path: File.Path) -> Bool {
    return List.fold(paths, false, path, PathMemberStep)
}

flow UniquePathStep(paths: List<File.Path>, path: File.Path) -> List<File.Path> {
    flow UniquePathStepChoiceTest1(request: Record{path: File.Path, paths: List<File.Path>, selector: Bool}) -> Bool {
        return request.selector
    }

    flow UniquePathStepChoiceResult1(request: Record{path: File.Path, paths: List<File.Path>, selector: Bool}) -> List<File.Path> {
        return request.paths
    }

    flow UniquePathStepChoiceDefault(request: Record{path: File.Path, paths: List<File.Path>, selector: Bool}) -> List<File.Path> {
        return ConcatPaths(request.paths, List.new(request.path))
    }

    return Record.new(selector: PathMember(paths, path), path: path, paths: paths) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(UniquePathStepChoiceTest1, UniquePathStepChoiceResult1)),
        default: UniquePathStepChoiceDefault
    ))
}

flow UniquePaths(paths: List<File.Path>) -> List<File.Path> {
    return List.fold(paths, List.new(), UniquePathStep)
}

flow ProbeNonemptyName(name: String) -> Bool! {
    flow ProbeNonemptyNameChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow ProbeNonemptyNameChoiceResult1(value: Bool) -> Bool! {
        return true
    }

    flow ProbeNonemptyNameChoiceDefault(value: Bool) -> Bool! {
        return Error.new("Probe.EmptyName", "empty probe name", Record.new())
    }

    return Math.gt(String.length(name), 0) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ProbeNonemptyNameChoiceTest1, ProbeNonemptyNameChoiceResult1)),
        default: ProbeNonemptyNameChoiceDefault
    ))
}

flow ProbeKnownPath(batch: List<File.Path>, path: File.Path) -> Bool! {
    flow ProbeKnownPathChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow ProbeKnownPathChoiceResult1(value: Bool) -> Bool! {
        return true
    }

    flow ProbeKnownPathChoiceDefault(value: Bool) -> Bool! {
        return Error.new("Probe.UnexpectedPath", "probe name outside candidate batch", Record.new())
    }

    return PathMember(batch, path) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ProbeKnownPathChoiceTest1, ProbeKnownPathChoiceResult1)),
        default: ProbeKnownPathChoiceDefault
    ))
}

flow ProbeName(batch: List<File.Path>, names: List<File.Path>, field: Bytes) -> List<File.Path>! {
    name = UTF8.String.new(Bytes.slice(field, 1, Bytes.length(field)))
    nonempty = ProbeNonemptyName(name)
    path = File.Path.new(name)
    known = ProbeKnownPath(batch, path)
    return UniquePathStep(names, path)
}

flow ProbeProcess(names: List<File.Path>, field: Bytes) -> List<File.Path>! {
    digits = UTF8.String.new(Bytes.slice(field, 1, Bytes.length(field)))
    nonempty = ProbeRequire(Math.gt(String.length(digits), 0), "empty process identifier")
    valid = ProbeRequire(List.fold(List.map(digits, ProbeDigit), true, ProbeAnd), "invalid process identifier")
    return names
}

flow ProbeField(batch: List<File.Path>, names: List<File.Path>, raw: Bytes) -> List<File.Path>! {
    field = Bytes.trim_start(raw, Bytes.new("\n"))
    nonempty = ProbeRequire(Math.gt(Bytes.length(field), 0), "empty probe field")
    flow ProbeFieldChoiceTest1(request: Record{batch: List<File.Path>, field: Bytes, names: List<File.Path>, selector: Bool}) -> Bool {
        return request.selector
    }

    flow ProbeFieldChoiceResult1(request: Record{batch: List<File.Path>, field: Bytes, names: List<File.Path>, selector: Bool}) -> List<File.Path>! {
        return ProbeName(request.batch, request.names, request.field)
    }

    flow ProbeFieldChoice2Test1(request: Record{field: Bytes, names: List<File.Path>, selector: Bool}) -> Bool {
        return request.selector
    }

    flow ProbeFieldChoice2Result1(request: Record{field: Bytes, names: List<File.Path>, selector: Bool}) -> List<File.Path>! {
        return ProbeProcess(request.names, request.field)
    }

    flow ProbeFieldChoice2Default(request: Record{field: Bytes, names: List<File.Path>, selector: Bool}) -> List<File.Path>! {
        return Error.new("Probe.InvalidFields", "unknown probe field", Record.new())
    }

    flow ProbeFieldChoiceDefault(request: Record{batch: List<File.Path>, field: Bytes, names: List<File.Path>, selector: Bool}) -> List<File.Path>! {
        return Record.new(selector: Bytes.starts_with(request.field, Bytes.new("p")), field: request.field, names: request.names) |> Match.apply(Match.new(
            cases: List.new(Match.Case.new(ProbeFieldChoice2Test1, ProbeFieldChoice2Result1)),
            default: ProbeFieldChoice2Default
        ))
    }

    return Record.new(selector: Bytes.starts_with(field, Bytes.new("n")), batch: batch, field: field, names: names) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ProbeFieldChoiceTest1, ProbeFieldChoiceResult1)),
        default: ProbeFieldChoiceDefault
    ))
}

flow ParseNonemptyProbe(input: Bytes, batch: List<File.Path>) -> List<File.Path>! {
    fields = Bytes.split(input, Bytes.new("\u0000"))
    delimited = ProbeRequire(Math.gt(List.length(fields), 1), "probe lacks NUL fields")
    trailer = Bytes.trim_start(List.at(fields, -1), Bytes.new("\n"))
    framed = ProbeRequire(Math.eq(Bytes.length(trailer), 0), "probe lacks terminal NUL")
    records = List.slice(fields, 0, Math.sub(List.length(fields), 1))
    return List.fold(records, List.new(), batch, ProbeField)
}

flow ParseProbe(input: Bytes, batch: List<File.Path>) -> List<File.Path>! {
    flow ParseProbeChoiceTest1(request: Record{batch: List<File.Path>, input: Bytes, selector: Int}) -> Bool {
        return Math.eq(request.selector, 0)
    }

    flow ParseProbeChoiceResult1(request: Record{batch: List<File.Path>, input: Bytes, selector: Int}) -> List<File.Path>! {
        return List.new()
    }

    flow ParseProbeChoiceDefault(request: Record{batch: List<File.Path>, input: Bytes, selector: Int}) -> List<File.Path>! {
        return ParseNonemptyProbe(request.input, request.batch)
    }

    return Record.new(selector: Bytes.length(input), batch: batch, input: input) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(ParseProbeChoiceTest1, ParseProbeChoiceResult1)),
        default: ParseProbeChoiceDefault
    ))
}

flow PathChunk(paths: List<File.Path>, size: Int, start: Int) -> Record{next_state: Int, value: List<File.Path>}! {
    proposed = Math.add(start, size)
    end = Record.new(selector: Math.gt(proposed, List.length(paths)), paths: paths, proposed: proposed) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(PathChunkEndChoiceTest1, PathChunkEndChoiceResult1)),
        default: PathChunkEndChoiceDefault
    ))
    flow PathChunkEndChoiceTest1(request: Record{paths: List<File.Path>, proposed: Int, selector: Bool}) -> Bool {
        return request.selector
    }

    flow PathChunkEndChoiceResult1(request: Record{paths: List<File.Path>, proposed: Int, selector: Bool}) -> Int {
        return List.length(request.paths)
    }

    flow PathChunkEndChoiceDefault(request: Record{paths: List<File.Path>, proposed: Int, selector: Bool}) -> Int {
        return request.proposed
    }

    return Record.new(next_state: end, value: List.slice(paths, start, end))
}

flow PositiveBatchSize(size: Int) -> Bool! {
    flow PositiveBatchSizeChoiceTest1(value: Bool) -> Bool {
        return value
    }

    flow PositiveBatchSizeChoiceResult1(value: Bool) -> Bool! {
        return true
    }

    flow PositiveBatchSizeChoiceDefault(value: Bool) -> Bool! {
        return Error.new("Probe.InvalidBatchSize", "batch size must be positive", Record.new())
    }

    return Math.gt(size, 0) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(PositiveBatchSizeChoiceTest1, PositiveBatchSizeChoiceResult1)),
        default: PositiveBatchSizeChoiceDefault
    ))
}

flow PathChunks(paths: List<File.Path>, size: Int) -> List<List<File.Path>>! {
    valid = PositiveBatchSize(size)
    count = Math.div(Math.add(List.length(paths), Math.sub(size, 1)), size)
    return List.unfold(0, count, paths, size, PathChunk)
}

flow PathEqualAt(left: List<File.Path>, right: List<File.Path>, index: Int) -> Record{next_state: Int, value: Bool}! {
    return Record.new(next_state: Math.add(index, 1), value: File.Path.eq(List.at(left, index), List.at(right, index)))
}

flow EqualLengthPaths(left: List<File.Path>, right: List<File.Path>) -> Bool! {
    comparisons = List.unfold(0, List.length(left), left, right, PathEqualAt)
    return List.fold(comparisons, true, ProbeAnd)
}

flow PathsEqual(left: List<File.Path>, right: List<File.Path>) -> Bool! {
    flow PathsEqualChoiceTest1(request: Record{left: List<File.Path>, right: List<File.Path>, selector: Bool}) -> Bool {
        return request.selector
    }

    flow PathsEqualChoiceResult1(request: Record{left: List<File.Path>, right: List<File.Path>, selector: Bool}) -> Bool! {
        return EqualLengthPaths(request.left, request.right)
    }

    flow PathsEqualChoiceDefault(request: Record{left: List<File.Path>, right: List<File.Path>, selector: Bool}) -> Bool! {
        return false
    }

    return Record.new(selector: Math.eq(List.length(left), List.length(right)), left: left, right: right) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(PathsEqualChoiceTest1, PathsEqualChoiceResult1)),
        default: PathsEqualChoiceDefault
    ))
}

flow JoinPathStep(separator: String, state: Record{first: Bool, text: String}, path: File.Path) -> Record{first: Bool, text: String} {
    boundary = Record.new(selector: state.first, separator: separator) |> Match.apply(Match.new(
        cases: List.new(Match.Case.new(JoinPathStepBoundaryChoiceTest1, JoinPathStepBoundaryChoiceResult1)),
        default: JoinPathStepBoundaryChoiceDefault
    ))
    flow JoinPathStepBoundaryChoiceTest1(request: Record{selector: Bool, separator: String}) -> Bool {
        return request.selector
    }

    flow JoinPathStepBoundaryChoiceResult1(request: Record{selector: Bool, separator: String}) -> String {
        return ""
    }

    flow JoinPathStepBoundaryChoiceDefault(request: Record{selector: Bool, separator: String}) -> String {
        return request.separator
    }

    return Record.new(first: false, text: String.concat(state.text, boundary, File.Path.to_string(path)))
}

flow JoinPathNames(paths: List<File.Path>, separator: String) -> String {
    joined = List.fold(paths, Record.new(first: true, text: ""), separator, JoinPathStep)
    return joined.text
}

return ParseProbe(Bytes.new("n/example/file\u0000"), List.new(File.Path.new("/example/file")))
